# Forked/extended: tracks files as well as directories, renamed z -> lazy.

# maintains a jump-list of the files and directories you actually use
#
# INSTALL:
#     * put something like this in your .bashrc/.zshrc:
#         . /path/to/lazy
#     * cd around / open files for a while to build up the db
#     * PROFIT!!
#     * the script defines cd() and e() wrapper functions for you (dir/file
#       fallback + tab completion). If you'd rather define your own:
#         set $_LAZY_NO_CD_WRAP to skip the cd() wrapper.
#         set $_LAZY_NO_E_WRAP to skip the e() wrapper.
#     * optionally:
#         set $_LAZY_CMD in .bashrc/.zshrc to change the command (default lazy).
#         set $_LAZY_DIR_DATA to change the directory datafile (default ~/.lazydir).
#         set $_LAZY_FILE_DATA to change the file datafile (default ~/.lazyfile).
#         set $_LAZY_MAX_SCORE lower to age entries out faster (default 9000).
#         set $_LAZY_EDITOR to the program used to open matched files (default $EDITOR, else vi).
#         set $_LAZY_NO_RESOLVE_SYMLINKS to prevent symlink resolution.
#         set $_LAZY_NO_PROMPT_COMMAND if you're handling PROMPT_COMMAND yourself.
#         set $_LAZY_EXCLUDE_DIRS to an array of directories to exclude.
#         set $_LAZY_OWNER to your username if you want use lazy while sudo with $HOME kept
#
# USE:
#     * lazy foo      # cd/open to most frecent match (dir -> cd, file -> $_LAZY_EDITOR)
#     * lazy dir foo   # restrict matches to directories, cd to the best one
#     * lazy file foo  # restrict matches to files, open the best one in $_LAZY_EDITOR
#     * lazy foo bar  # match against foo and bar
#     * lazy -r foo   # go to highest ranked match
#     * lazy -t foo   # go to most recently accessed match
#     * lazy -l foo   # list matches instead of acting on them
#     * lazy -e foo   # echo the best match, don't cd/open
#     * lazy -c foo   # restrict matches to subdirs of $PWD
#     * lazy -x       # remove the current directory from the datafile
#     * lazy -h       # show a brief help message

[ -d "${_LAZY_DIR_DATA:-$HOME/.lazydir}" ] && {
    echo "ERROR: lazy's directory datafile (${_LAZY_DIR_DATA:-$HOME/.lazydir}) is a directory."
}
[ -d "${_LAZY_FILE_DATA:-$HOME/.lazyfile}" ] && {
    echo "ERROR: lazy's file datafile (${_LAZY_FILE_DATA:-$HOME/.lazyfile}) is a directory."
}

_lazy() {

    # help / usage, checked first so it works with no datafiles present
    case "$1" in
        help|-h|--help)
            local cmd="${_LAZY_CMD:-lazy}"
            cat <<EOF
$cmd - frecency-based jump list for directories and files

USAGE
  $cmd foo             go to the best match (dir -> cd, file -> open in \$_LAZY_EDITOR)
  $cmd dir foo         restrict matches to directories, cd to the best one
  $cmd file foo        restrict matches to files, open the best one
  $cmd foo bar         match against multiple terms (space = wildcard)
  cd foo               (if cd() wrapper is enabled) falls back to '$cmd dir foo'
  e foo                (if e() wrapper is enabled) falls back to '$cmd file foo'

  NOTE: the "dir"/"file" subcommand must come immediately after '$cmd',
  before any flags, e.g. '$cmd file -e foo', not '$cmd -e file foo'.

FLAGS (combine like -le, put after dir/file if used)
  -c    restrict matches to subdirectories of \$PWD
  -e    echo the best match instead of cd-ing/opening it
  -h    show this help (also: '$cmd help', '$cmd --help')
  -l    list all matches instead of acting on one
  -r    go by highest rank instead of frecency
  -t    go by most recently accessed instead of frecency
  -x    remove the current directory from the directory datafile
  --    treat all remaining args as literal search terms

TUNABLES (export these in .bashrc/.zshrc before sourcing $cmd)
  _LAZY_CMD               command name to alias '_lazy' to (default: lazy)
  _LAZY_DIR_DATA          directory datafile path (default: ~/.lazydir)
  _LAZY_FILE_DATA         file datafile path (default: ~/.lazyfile)
  _LAZY_MAX_SCORE         aging threshold before scores decay (default: 9000)
  _LAZY_EDITOR            program used to open matched files (default: \$EDITOR, else vi)
  _LAZY_OWNER             username to chown datafiles to (for use under sudo)
  _LAZY_EXCLUDE_DIRS      array of path prefixes to never track
  _LAZY_NO_RESOLVE_SYMLINKS   don't resolve symlinks when tracking \$PWD
  _LAZY_NO_PROMPT_COMMAND     don't auto-hook PROMPT_COMMAND/precmd to track \$PWD
  _LAZY_NO_CD_WRAP        don't define the built-in cd() wrapper
  _LAZY_NO_E_WRAP         don't define the built-in e() wrapper

DATA FORMAT
  Each line in a datafile is: path|rank|last_accessed_epoch
EOF
            return
            ;;
    esac

    local dirfile="${_LAZY_DIR_DATA:-$HOME/.lazydir}"
    local filefile="${_LAZY_FILE_DATA:-$HOME/.lazyfile}"

    # if symlink, dereference
    [ -h "$dirfile" ] && dirfile=$(readlink "$dirfile")
    [ -h "$filefile" ] && filefile=$(readlink "$filefile")

    # bail if we don't own the datafiles and $_LAZY_OWNER not set
    [ -z "$_LAZY_OWNER" -a -f "$dirfile" -a ! -O "$dirfile" ] && return
    [ -z "$_LAZY_OWNER" -a -f "$filefile" -a ! -O "$filefile" ] && return

    # mode: "" = files+dirs, "file" = files only, "dir" = directories only
    local mode=""

    # read one datafile, keeping only entries whose path still exists as $2 (d|f)
    _lazy_read () {
        local f="$1" type="$2" line p
        [ -f "$f" ] || return 0
        while read line; do
            p="${line%%\|*}"
            if [ "$type" = "d" ]; then
                [ -d "$p" ] && echo "$line"
            else
                [ -f "$p" ] && echo "$line"
            fi
        done < "$f"
        return 0
    }

    _lazy_entries () {
        case "$mode" in
            file) _lazy_read "$filefile" f;;
            dir)  _lazy_read "$dirfile" d;;
            *)    _lazy_read "$dirfile" d; _lazy_read "$filefile" f;;
        esac
    }

    # add entries
    if [ "$1" = "--add" ]; then
        shift

        # $HOME and / aren't worth matching
        [ "$*" = "$HOME" -o "$*" = '/' ] && return

        # don't track excluded directory trees
        if [ ${#_LAZY_EXCLUDE_DIRS[@]} -gt 0 ]; then
            local exclude
            for exclude in "${_LAZY_EXCLUDE_DIRS[@]}"; do
                case "$*" in "$exclude"*) return;; esac
            done
        fi

        # figure out which datafile this path belongs in
        local target type
        if [ -d "$*" ]; then
            target="$dirfile"; type=d
        elif [ -f "$*" ]; then
            target="$filefile"; type=f
        else
            return
        fi

        # maintain the data file
        local tempfile="$target.$RANDOM"
        local score=${_LAZY_MAX_SCORE:-9000}
        _lazy_read "$target" "$type" | \awk -v path="$*" -v now="$(\date +%s)" -v score=$score -F"|" '
            BEGIN {
                rank[path] = 1
                time[path] = now
            }
            $2 >= 1 {
                # drop ranks below 1
                if( $1 == path ) {
                    rank[$1] = $2 + 1
                    time[$1] = now
                } else {
                    rank[$1] = $2
                    time[$1] = $3
                }
                count += $2
            }
            END {
                if( count > score ) {
                    # aging
                    for( x in rank ) print x "|" 0.99*rank[x] "|" time[x]
                } else for( x in rank ) print x "|" rank[x] "|" time[x]
            }
        ' 2>/dev/null >| "$tempfile"
        # do our best to avoid clobbering the datafile in a race condition.
        if [ $? -ne 0 -a -f "$target" ]; then
            \env rm -f "$tempfile"
        else
            [ "$_LAZY_OWNER" ] && chown $_LAZY_OWNER:"$(id -ng $_LAZY_OWNER)" "$tempfile"
            \env mv -f "$tempfile" "$target" || \env rm -f "$tempfile"
        fi

    # tab completion
    elif [ "$1" = "--complete" -a \( -s "$dirfile" -o -s "$filefile" \) ]; then
        # $2 is the full line being completed (e.g. "cd fo", "e fo", "lazy file fo").
        # Use its leading word(s) to decide which datafile(s) to search.
        local complline="$2" firstword
        firstword="${complline%% *}"
        case "$firstword" in
            cd) mode="dir";;
            e)  mode="file";;
            *)
                case "$complline" in
                    "$firstword dir "*)  mode="dir";;
                    "$firstword file "*) mode="file";;
                esac
                ;;
        esac
        local query="${complline#"$firstword" }"
        case "$mode" in
            dir)  query="${query#dir }";;
            file) query="${query#file }";;
        esac
        _lazy_entries | \awk -v q="$query" -F"|" '
            BEGIN {
                if( q == tolower(q) ) imatch = 1
                gsub(/ /, ".*", q)
            }
            {
                if( imatch ) {
                    if( tolower($1) ~ q ) print $1
                } else if( $1 ~ q ) print $1
            }
        ' 2>/dev/null

    else
        # list/go

        # optional leading "file" / "dir" subcommand to restrict match type
        case "$1" in
            file) mode="file"; shift;;
            dir)  mode="dir"; shift;;
        esac

        local echo fnd last list opt typ
        while [ "$1" ]; do case "$1" in
            --) while [ "$1" ]; do shift; fnd="$fnd${fnd:+ }$1";done;;
            -*) opt=${1:1}; while [ "$opt" ]; do case ${opt:0:1} in
                    c) fnd="^$PWD $fnd";;
                    e) echo=1;;
                    h) _lazy help; return;;
                    l) list=1;;
                    r) typ="rank";;
                    t) typ="recent";;
                    x) \sed -i -e "\:^${PWD}|.*:d" "$dirfile";;
                esac; opt=${opt:1}; done;;
             *) fnd="$fnd${fnd:+ }$1";;
        esac; last=$1; [ "$#" -gt 0 ] && shift; done
        [ "$fnd" -a "$fnd" != "^$PWD " ] || list=1

        # if we hit enter on a completion just go there
        case "$last" in
            # completions will always start with /
            /*)
                if [ -z "$list" ]; then
                    if [ -d "$last" ]; then
                        builtin cd "$last" && return
                    elif [ -f "$last" ]; then
                        (_lazy --add "$last" &)
                        ${_LAZY_EDITOR:-${EDITOR:-vi}} "$last"
                        return
                    fi
                fi
            ;;
        esac

        # no data yet for the relevant type(s)
        case "$mode" in
            file) [ -f "$filefile" ] || return;;
            dir)  [ -f "$dirfile" ] || return;;
            *)    [ -f "$dirfile" -o -f "$filefile" ] || return;;
        esac

        local cd
        cd="$( < <( _lazy_entries ) \awk -v t="$(\date +%s)" -v list="$list" -v typ="$typ" -v q="$fnd" -F"|" '
            function frecent(rank, time) {
              # relate frequency and time
              dx = t - time
              return int(10000 * rank * (3.75/((0.0001 * dx + 1) + 0.25)))
            }
            function output(matches, best_match, common) {
                # list or return the desired entry
                if( list ) {
                    if( common ) {
                        printf "%-10s %s\n", "common:", common > "/dev/stderr"
                    }
                    cmd = "sort -n >&2"
                    for( x in matches ) {
                        if( matches[x] ) {
                            printf "%-10s %s\n", matches[x], x | cmd
                        }
                    }
                } else {
                    if( common && !typ ) best_match = common
                    print best_match
                }
            }
            function common(matches) {
                # find the common root of a list of matches, if it exists
                for( x in matches ) {
                    if( matches[x] && (!short || length(x) < length(short)) ) {
                        short = x
                    }
                }
                if( short == "/" ) return
                for( x in matches ) if( matches[x] && index(x, short) != 1 ) {
                    return
                }
                return short
            }
            BEGIN {
                gsub(" ", ".*", q)
                hi_rank = ihi_rank = -9999999999
            }
            {
                if( typ == "rank" ) {
                    rank = $2
                } else if( typ == "recent" ) {
                    rank = $3 - t
                } else rank = frecent($2, $3)
                if( $1 ~ q ) {
                    matches[$1] = rank
                } else if( tolower($1) ~ tolower(q) ) imatches[$1] = rank
                if( matches[$1] && matches[$1] > hi_rank ) {
                    best_match = $1
                    hi_rank = matches[$1]
                } else if( imatches[$1] && imatches[$1] > ihi_rank ) {
                    ibest_match = $1
                    ihi_rank = imatches[$1]
                }
            }
            END {
                # prefer case sensitive
                if( best_match ) {
                    output(matches, best_match, common(matches))
                    exit
                } else if( ibest_match ) {
                    output(imatches, ibest_match, common(imatches))
                    exit
                }
                exit(1)
            }
        ')"

        if [ "$?" -eq 0 ]; then
          if [ "$cd" ]; then
            if [ "$echo" ]; then
                echo "$cd"
            elif [ -d "$cd" ]; then
                builtin cd "$cd"
            elif [ -f "$cd" ]; then
                (_lazy --add "$cd" &)
                ${_LAZY_EDITOR:-${EDITOR:-vi}} "$cd"
            fi
          fi
        else
          return $?
        fi
    fi
}

alias ${_LAZY_CMD:-lazy}='_lazy 2>&1'

[ "$_LAZY_NO_RESOLVE_SYMLINKS" ] || _LAZY_RESOLVE_SYMLINKS="-P"

if type compctl >/dev/null 2>&1; then
    # zsh
    [ "$_LAZY_NO_PROMPT_COMMAND" ] || {
        # populate directory list, avoid clobbering any other precmds.
        if [ "$_LAZY_NO_RESOLVE_SYMLINKS" ]; then
            _lazy_precmd() {
                (_lazy --add "${PWD:a}" &)
                : $RANDOM
            }
        else
            _lazy_precmd() {
                (_lazy --add "${PWD:A}" &)
                : $RANDOM
            }
        fi
        [[ -n "${precmd_functions[(r)_lazy_precmd]}" ]] || {
            precmd_functions[$(($#precmd_functions+1))]=_lazy_precmd
        }
    }
    _lazy_zsh_tab_completion() {
        # tab completion
        local compl
        read -l compl
        reply=(${(f)"$(_lazy --complete "$compl")"})
    }
    compctl -U -K _lazy_zsh_tab_completion _lazy
    [ "$_LAZY_NO_CD_WRAP" ] || compctl -U -K _lazy_zsh_tab_completion cd
    [ "$_LAZY_NO_E_WRAP" ] || compctl -U -K _lazy_zsh_tab_completion e
elif type complete >/dev/null 2>&1; then
    # bash
    # tab completion
    complete -o filenames -C '_lazy --complete "$COMP_LINE"' ${_LAZY_CMD:-lazy}
    [ "$_LAZY_NO_CD_WRAP" ] || complete -o filenames -o dirnames -C '_lazy --complete "$COMP_LINE"' cd
    [ "$_LAZY_NO_E_WRAP" ] || complete -o filenames -o dirnames -C '_lazy --complete "$COMP_LINE"' e
    [ "$_LAZY_NO_PROMPT_COMMAND" ] || {
        # populate directory list. avoid clobbering other PROMPT_COMMANDs.
        grep "_lazy --add" <<< "$PROMPT_COMMAND" >/dev/null || {
            PROMPT_COMMAND="$PROMPT_COMMAND"$'\n''(_lazy --add "$(command pwd '$_LAZY_RESOLVE_SYMLINKS' 2>/dev/null)" 2>/dev/null &);'
        }
    }
fi

# cd wrapper: falls through to lazy directory matching when the arg isn't
# a real directory. Set $_LAZY_NO_CD_WRAP to skip defining this.
[ "$_LAZY_NO_CD_WRAP" ] || {
    cd() {
        if [ $# -eq 0 ]; then
            builtin cd "$HOME" || return
        elif [ -d "$1" ] || [ "$1" = "-" ]; then
            builtin cd "$@" || return
        else
            _lazy dir "$@"
        fi
    }
}

# e wrapper: opens a real file directly, otherwise falls through to lazy
# file matching. Set $_LAZY_NO_E_WRAP to skip defining this.
[ "$_LAZY_NO_E_WRAP" ] || {
    e() {
        if [ -f "$1" ]; then
            (_lazy --add "$1" &)
            ${_LAZY_EDITOR:-${EDITOR:-vi}} "$1"
        else
            _lazy file "$@"
        fi
    }
}
