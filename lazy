_LAZY_REAL_HOME="$(realpath "$HOME" 2>/dev/null || echo "$HOME")"
_LAZY_DIR_DB="$(realpath "${_LAZY_DIR_DB:-$_LAZY_REAL_HOME/.lazydir}" 2>/dev/null || echo "${_LAZY_DIR_DB:-$_LAZY_REAL_HOME/.lazydir}")"
_LAZY_FILE_DB="$(realpath "${_LAZY_FILE_DB:-$_LAZY_REAL_HOME/.lazyfile}" 2>/dev/null || echo "${_LAZY_FILE_DB:-$_LAZY_REAL_HOME/.lazyfile}")"

[[ -d "$_LAZY_DIR_DB" || -d "$_LAZY_FILE_DB" ]] && { echo "lazy: $_LAZY_DIR_DB or $_LAZY_FILE_DB is a directory" >&2; return 1; }

_LAZY_MAX_ENTRIES=$(
	awk -v H="${_LAZY_HALF_LIFE:-85}" -v M="${_LAZY_MAX_ENTRIES:-1000}" '
		BEGIN { 
			safe = int(1 / (1 - (0.5 ^ (1 / H)))) + 1; 
			if (M < safe) { 
				printf "lazy: _LAZY_MAX_ENTRIES is too low. Automatically set to the minimum safe number (%d) to guarantee entry tracking.\n", safe > "/dev/stderr";
				print safe
			} else print M 
		}
	'
)

export EDITOR="${EDITOR:-${VISUAL:-nano}}"
export VISUAL="$EDITOR"

_lazy_editor_alias="${EDITOR%% *}"
alias cd='_lazy_cd'
alias "${_lazy_editor_alias##*/}"='_lazy_editor'

_lazy_write() {
	[[ ! ( ( "$1" == "$_LAZY_DIR_DB" && "$2" == "-d" ) || ( "$1" == "$_LAZY_FILE_DB" && "$2" == "-f" ) ) || -z "$3" ]] && return 1
    [[ ( "$2" == "-d" && "$3" != "$HOME/"* ) || ( "$2" == "-f" && "$3" != "$_LAZY_REAL_HOME/"* ) ]] && return 0

    local blacklist
    for blacklist in "${@:4}"; do
        [[ -n "$blacklist" && "$3" == "$blacklist"* ]] && return 0
    done

    [[ -f "$1" ]] || touch "$1" 2>/dev/null || return 1
    local tempfile="$(mktemp "${1}.XXXXXX")"
    
    if while IFS=$'\t' read -r path rest; do
        [ $2 "$path" ] && printf "%s\t%s\n" "$path" "$rest"
    done < "$1" 2>/dev/null | awk -F'\t' -v target="$3" -v H="${_LAZY_HALF_LIFE:-85}" '
        BEGIN { OFS="\t"; OFMT="%.17g"; CONVFMT="%.17g"; decay = 2 ^ (1 / H) }
        NF == 2 {
            if ($1 == target) {
                found = 1
                print $1, ($2 / decay) + 1
            } else print $1, $2 / decay
        }
        END { if (!found) print target, 1 }
    ' | LC_ALL=C sort -t$'\t' -k2,2gr -k1,1 | head -n "$_LAZY_MAX_ENTRIES" > "$tempfile" && [[ -s "$tempfile" ]]; then
    	\env mv -f "$tempfile" "$1"
	else
    	\env rm -f "$tempfile"
	fi
}

_lazy_read() {
    [[ -z "$2" || ! -f "$1" ]] && return 1
    awk -F'\t' -v query="${*:2}" '
        BEGIN {
            gsub(/ /, ".*", query)
            case_sensitive = (query != tolower(query))
        }
        NF == 2 {
            base = parts[split($1, parts, "/")]
            if ((case_sensitive ? base : tolower(base)) ~ query) {
                print $1
                found = 1
                exit
            }
        }
        END { exit !found }
    ' "$1"
}

_lazy_cd() {
    local old_pwd="$PWD"
    [[ $# -gt 0 && "$1" != "-" && ! -d "$*" ]] && set -- "$(_lazy_read "$_LAZY_DIR_DB" "$@" || echo "$*")"
    builtin cd ${1+"$*"} || return
    [[ "$old_pwd" != "$PWD" ]] && (_lazy_write "$_LAZY_DIR_DB" -d "$PWD" ${_LAZY_DIR_BLACKLIST[@]+"${_LAZY_DIR_BLACKLIST[@]}"} 2>/dev/null &)
}

_lazy_editor() {
    if [[ -n "${ZSH_VERSION-}" ]]; then
    	local _LAZY_EDITOR_ARR=(${=EDITOR})
	else 
		local _LAZY_EDITOR_ARR=($EDITOR)
	fi
	
    [[ $# -eq 0 || " $*" == *" "[-+]* ]] && {
    	command "${_LAZY_EDITOR_ARR[@]}" "$@"
    	return
    }
    local target exec_cmd
    for target; do
        exec_cmd=("${_LAZY_EDITOR_ARR[@]}")
        
        [[ "$target" != */* && ! -e "$target" ]] && target="$(_lazy_read "$_LAZY_FILE_DB" "$target" 2>/dev/null || echo "$target")"
        if [[ -f "$target" ]]; then
            target="$(realpath "$target" 2>/dev/null || echo "$target")"
            (_lazy_write "$_LAZY_FILE_DB" -f "$target" ${_LAZY_FILE_BLACKLIST[@]+"${_LAZY_FILE_BLACKLIST[@]}"} &)
            [[ ! -w "$target" ]] && exec_cmd=(sudo -e)
        else
        	local dname="${target%/*}"
        	[[ "$dname" == "$target" ]] && dname="."
        	[[ -z "$dname" ]] && dname="/"
        	[[ ! -d "$dname" ]] && {
        		echo "lazy: directory '$dname' does not exist for target '$target'" >&2
        		continue
        	}
            [[ ! -w "$dname" ]] && exec_cmd=(sudo -e)
        fi
        command "${exec_cmd[@]}" "$target"
    done
}

if [[ -n "${BASH_VERSION-}" ]]; then
    _lazy_complete() {
        [[ -z "${COMP_LINE+x}" ]] && return 1

		if [[ "$1" = *"cd" ]]; then
			(( COMP_CWORD > 1 )) && return 0
			local target="$_LAZY_DIR_DB" comp_opt="-d" home_prefix="$HOME" path meta
		else
			local target="$_LAZY_FILE_DB" comp_opt="-f" home_prefix="$_LAZY_REAL_HOME" path meta
		fi
        
        COMPREPLY=()
        local -A seen_paths
        
        [[ -s "$target" && "$2" != */* ]] && {
            local pattern="${2// /*}" local_nocase=0
            [[ "$pattern" == "${pattern,,}" ]] && ! shopt -q nocasematch && {
            	shopt -s nocasematch
            	local_nocase=1
            }
            while IFS=$'\t' read -r path meta; do
                [[ -n "$path" && "$path" == *"$pattern"* ]] && {
                    COMPREPLY+=("${path/#$home_prefix/\~}")
                    seen_paths["$path"]=1
                    (( ${#seen_paths[@]} >= ${_LAZY_MAX_COMPLETIONS:-10} )) && break
                }
            done < "$target"
            [[ $local_nocase -eq 1 ]] && shopt -u nocasematch
        }
        mapfile -t path < <(compgen "$comp_opt" -- "$2")
        
        [[ ${#path[@]} -eq 0 ]] && return 0
        
        if [[ ${#seen_paths[@]} -eq 0 ]]; then
            COMPREPLY+=("${path[@]}")
        else
            if [[ "$comp_opt" == "-f" ]]; then
                mapfile -t meta < <(realpath "${path[@]}" 2>/dev/null)
            elif [[ "$2" != /* ]]; then
                meta=("${path[@]/#/$PWD/}")
            else
                meta=("${path[@]}")
            fi
            
            for ((i=0; i<${#path[@]}; i++)); do
                [[ ! -v seen_paths["${meta[i]}"] ]] && COMPREPLY+=("${path[i]}")
            done
        fi
    }
    complete -o nosort -o dirnames -o bashdefault -o default -F _lazy_complete _lazy_cd cd
    complete -o nosort -o bashdefault -o default -F _lazy_complete _lazy_editor ${_lazy_editor_alias##*/}

elif [[ -n "${ZSH_VERSION-}" ]]; then
    _lazy_complete() {
        if [[ "$words[1]" == "_lazy_cd" ]]; then
            (( CURRENT > 2 )) && return 0
            local target="$_LAZY_DIR_DB" comp_cmd=(_path_files -/) home_prefix="$HOME" path_mod="a" ignore_list paths meta
        else
        	local target="$_LAZY_FILE_DB" comp_cmd=(_files) home_prefix="$_LAZY_REAL_HOME" path_mod="A" ignore_list paths meta
        fi
        
		local -A seen_paths
        [[ -s "$target" && "$PREFIX" != */* ]] && {
            while IFS=$'\t' read -r paths meta; do
                [[ -n "$paths" && "${(L)paths}" == *"${(L)PREFIX// /*}"* ]] && {
                    compadd -U -Q -V lazy_db -- "~/${(q)paths#$home_prefix/}"
                    seen_paths[$paths]=1
                    (( ${#seen_paths[@]} >= ${_LAZY_MAX_COMPLETIONS:-10} )) && break
                }
            done < "$target"
        }
        eval 'for paths in ${PREFIX}*(N); do
            [[ -v seen_paths[${paths:'"$path_mod"'}] ]] && ignore_list+=("${paths:t}")
        done'

        "${comp_cmd[@]}" -F ignore_list
    }
    type compdef >/dev/null 2>&1 || {
    	autoload -Uz compinit
    	compinit
    }
    compdef _lazy_complete _lazy_cd
    compdef _lazy_complete _lazy_editor
fi

lazy() {
    printf "lazy - frecency-based smart cd and editor launcher\n\n\
USAGE\n\
  %-21s%s\n\
  %-21s%s\n\
  %-21s%s\n\n\
TUNABLES (initialize these in .bashrc before sourcing lazy)\n\
  _LAZY_DIR_DB            directory datafile path (default: ~/.lazydir)\n\
  _LAZY_FILE_DB           file datafile path (default: ~/.lazyfile)\n\
  _LAZY_DIR_BLACKLIST     array of path prefixes to ignore for cd (default: empty)\n\
  _LAZY_FILE_BLACKLIST    array of path prefixes to ignore for editor (default: empty)\n\
  _LAZY_HALF_LIFE         commands until score halves (default: 85)\n\
  _LAZY_MAX_ENTRIES       maximum number of entries to track per file (default: 1000)\n\
  _LAZY_MAX_COMPLETIONS   maximum number of matches to show in completion (default: 10)\n\
  EDITOR                  program used to open matched files (default: nano)\n\n\
CURRENT STATS\n\
  %-24s%s\n\
  %-24s%s\n\
  %-24s%s\n" \
        "lazy" "show this help" \
        "cd foo" "falls back to smart directory jump" \
        "${_lazy_editor_alias##*/} foo" "falls back to smart file open (auto-escalates if no write permission)" \
        "Half-Life" "${_LAZY_HALF_LIFE:-85} commands" \
        "Maximum Entries" "$_LAZY_MAX_ENTRIES" \
        "Maximum possible score" "$(awk -v H="${_LAZY_HALF_LIFE:-85}" 'BEGIN { printf "%.1f", 1 / (1 - (0.5 ^ (1 / H))) }')"
}
