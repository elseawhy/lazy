shopt -s extglob

readonly _LAZY_REAL_HOME="$(realpath -m "$HOME" 2>/dev/null || echo "$HOME")"
readonly dirfile="$(realpath -m "${_LAZY_DIR_DATA:-$_LAZY_REAL_HOME/.lazydir}" 2>/dev/null || echo "${_LAZY_DIR_DATA:-$_LAZY_REAL_HOME/.lazydir}")"
readonly filefile="$(realpath -m "${_LAZY_FILE_DATA:-$_LAZY_REAL_HOME/.lazyfile}" 2>/dev/null || echo "${_LAZY_FILE_DATA:-$_LAZY_REAL_HOME/.lazyfile}")"

[[ -d "$dirfile" ]] && { echo "ERROR: lazy's dir datafile ($dirfile) is a directory."; return 1; }
[[ -d "$filefile" ]] && { echo "ERROR: lazy's file datafile ($filefile) is a directory."; return 1; }

export EDITOR="${EDITOR:-${VISUAL:-nano}}"
export VISUAL="$EDITOR"
_LAZY_EDITOR_NAME="${EDITOR%% *}"
_LAZY_EDITOR_NAME="${_LAZY_EDITOR_NAME##*/}"
readonly _LAZY_EDITOR_NAME

_LAZY_DIR_BLACKLIST="${_LAZY_DIR_BLACKLIST:-!($_LAZY_REAL_HOME/*)}"
_LAZY_FILE_BLACKLIST="${_LAZY_FILE_BLACKLIST:-!($_LAZY_REAL_HOME/*)}"

lazy() {
    awk -v H="${_LAZY_HALF_LIFE:-85}" -v M="${_LAZY_MAX_ENTRIES:-1000}" \
        -v editor="$_LAZY_EDITOR_NAME" 'BEGIN {
        print "lazy - frecency-based smart cd and editor launcher\n"
        print "USAGE"
        printf "  %-21s%s\n", "lazy help", "show this help"
        printf "  %-21s%s\n", "cd foo", "falls back to smart directory jump"
        printf "  %-21s%s\n\n", editor " foo", "falls back to smart file open (auto-escalates if outside $HOME)"
        print "TUNABLES (export these in .bashrc before sourcing lazy)"
        print "  _LAZY_DIR_DATA          directory datafile path (default: ~/.lazydir)"
        print "  _LAZY_FILE_DATA         file datafile path (default: ~/.lazyfile)"
        print "  _LAZY_HALF_LIFE         commands until score halves (default: 85)"
        print "  _LAZY_MAX_ENTRIES       maximum number of entries to track per file (default: 1000)"
        print "  _LAZY_DIR_BLACKLIST     colon-separated glob patterns to ignore for cd (default: !($HOME/*))"
        print "  _LAZY_FILE_BLACKLIST    colon-separated glob patterns to ignore for editor (default: !($HOME/*))"
        print "  EDITOR                  program used to open matched files (default: nano)\n"
        print "CURRENT STATS (Half-Life: " H ", Max Entries: " M ")"
        printf "  Maximum possible score: %.1f\n", 1 / (1 - (0.5 ^ (1 / H)))
    }'
}

_lazy_is_blacklisted() {
    [[ -z "$1" ]] && return 1
    local pattern
    while IFS= read -r pattern; do
        [[ -z "$pattern" ]] && continue
        [[ "$2" == $pattern ]] && return 0
    done <<< "${1//:/$'\n'}"
    return 1
}

_lazy_write() {
    local tempfile="$1.$RANDOM" flag="-f"
    [[ "$1" == "$dirfile" ]] && flag="-d"
    
    awk -F"|" -v target="$2" -v H="${_LAZY_HALF_LIFE:-85}" '
        BEGIN { OFS="|"; OFMT="%.17g"; CONVFMT="%.17g" }
        {
            lines[NR] = $0
            if ($3 > tmax) tmax = $3
            if ($1 == target) {
                target_idx = NR
                visits = $2
                last_tick = $3
                score = $4
            }
        }
        END {
            if (target_idx) {
                score = score / (2 ^ ((tmax + 1 - last_tick) / H)) + 1
                lines[target_idx] = target "|" (visits + 1) "|" (tmax + 1) "|" score
            } else {
                lines[++NR] = target "|1|" (tmax + 1) "|1"
            }
            for (i=1; i<=NR; i++) {
                split(lines[i], f, "|")
                if (f[1] != target) {
                    current_score = f[4] / (2 ^ ((tmax + 1 - f[3]) / H))
                    print f[1], f[2], f[3], current_score
                } else {
                    print lines[i]
                }
            }
        }
    ' "$1" 2>/dev/null | while IFS="|" read -r path rest; do
        [ $flag "$path" ] && echo "$path|$rest"
    done | LC_ALL=C sort -t'|' -k4,4g -k1,1 | tail -n "${_LAZY_MAX_ENTRIES:-1000}" > "$tempfile"

    if [[ -s "$tempfile" ]]; then
        \env mv -f "$tempfile" "$1"
    else
        \env rm -f "$tempfile"
    fi
}

_lazy_complete_func() {
    local target="$filefile"
    [[ "$1" == "cd" ]] && { (( COMP_CWORD > 1 )) && return 0; target="$dirfile"; }

    COMPREPLY=()
    local path rank time added_abs_paths=$'\n'
    
    if [[ -s "$target" ]] && [[ "$2" != */* ]]; then
        local q_frecency="${2// /*}"
        local q_lower="${q_frecency,,}"

        while IFS="|" read -r path rest; do
            [[ -z "$path" ]] && continue
            
            if [[ "$q_frecency" == "$q_lower" && "${path,,}" == *"$q_lower"* ]] || \
               [[ "$q_frecency" != "$q_lower" && "$path" == *"$q_frecency"* ]]; then
                COMPREPLY+=("${path/#$_LAZY_REAL_HOME/\~}")
                added_abs_paths+="${path}"$'\n'
            fi
        done < "$target"
    fi

    local local_path abs_local_path
    while IFS= read -r local_path; do
        [[ -z "$local_path" ]] && continue
        abs_local_path="$local_path"
        [[ "$local_path" != /* ]] && abs_local_path="$PWD/$local_path"
        
        if [[ "$added_abs_paths" != *$'\n'"$abs_local_path"$'\n'* ]]; then
            COMPREPLY+=("$local_path")
            added_abs_paths+="${abs_local_path}"$'\n'
        fi
    done < <( if [[ "$target" == "$dirfile" ]]; then compgen -d -- "$2"; else compgen -f -- "$2"; fi )
}

_lazy_read() {
    [[ -z "$2" ]] && return 1
    [[ -f "$1" ]] || return 1

    awk -F"|" -v q="${*:2}" -v H="${_LAZY_HALF_LIFE:-85}" '
        BEGIN { 
            gsub(/ /, ".*", q)
            q_lower = tolower(q)
        }
        {
            if ($3 > tmax) tmax = $3
            lines[NR] = $0
        }
        END {
            for (i=1; i<=NR; i++) {
                split(lines[i], f, "|")
                
                if (tolower(f[1]) ~ q_lower) {
                    current_score = f[4] / (2 ^ ((tmax + 1 - f[3]) / H))
                    if (f[1] ~ q) {
                        if (current_score > hi) { hi = current_score; bm = f[1] }
                    } else {
                        if (current_score > ihi) { ihi = current_score; ibm = f[1] }
                    }
                }
            }
            if (bm) { print bm; exit 0 }
            else if (ibm) { print ibm; exit 0 }
            exit 1
        }
    ' "$1" || return 1
}

complete -o nosort -o filenames -o dirnames -o bashdefault -o default -F _lazy_complete_func cd
complete -o nosort -o filenames -o bashdefault -o default -F _lazy_complete_func "$_LAZY_EDITOR_NAME"

cd() {
    local old_pwd="$(command pwd -P 2>/dev/null)"
    if [[ $# -eq 0 ]]; then
        builtin cd || return
    elif [[ "$1" == "-" || -d "$*" ]]; then
        builtin cd "$*" || return
    else
        builtin cd "$(_lazy_read "$dirfile" "$@" || echo "$*")" || return
    fi
    local new_pwd="$(command pwd -P 2>/dev/null)"

    if [[ "$-" == *i* ]] && [[ "$old_pwd" != "$new_pwd" ]] && ! _lazy_is_blacklisted "$_LAZY_DIR_BLACKLIST" "$new_pwd"; then
        (_lazy_write "$dirfile" "$new_pwd" 2>/dev/null &)
    fi
}

eval "
${_LAZY_EDITOR_NAME}() {
    [[ \$# -eq 0 ]] && { command \${EDITOR} ; return ; }
    local -a _lazy_editor_cmd=(\$EDITOR)
    for target in \"\$@\"; do
		if [[ \"\$target\" != */* && ! -f \"\$target\" ]]; then
			target=\"\$(_lazy_read \"\$filefile\" \"\$target\" || echo \"\$target\")\"
		fi
               
		[[ \"\$target\" != /* ]] && target=\"\$(realpath -m \"\$target\" 2>/dev/null || echo \"\$target\")\"
               
		if ! _lazy_is_blacklisted \"\$_LAZY_FILE_BLACKLIST\" \"\$target\"; then
			[[ -f \"\$target\" ]] && (_lazy_write \"\$filefile\" \"\$target\" &)
		fi
		
		if [[ -e \"\$target\" ]]; then
			if [[ -w \"\$target\" ]]; then
				command \"\${_lazy_editor_cmd[@]}\" \"\$target\"
			else
				command sudo -e \"\$target\"
			fi
		else
			if [[ -w \"\$(dirname \"\$target\")\" ]]; then
				command \"\${_lazy_editor_cmd[@]}\" \"\$target\"
			else
				command sudo \"\${_lazy_editor_cmd[@]}\" \"\$target\"
			fi
		fi
    done
}"
