[ -d "${_LAZY_DIR_DATA:-$HOME/.lazydir}" ] && {
    echo "ERROR: lazy's directory datafile (${_LAZY_DIR_DATA:-$HOME/.lazydir}) is a directory."
    return 1 2>/dev/null || exit 1
}
[ -d "${_LAZY_FILE_DATA:-$HOME/.lazyfile}" ] && {
    echo "ERROR: lazy's file datafile (${_LAZY_FILE_DATA:-$HOME/.lazyfile}) is a directory."
    return 1 2>/dev/null || exit 1
}

# Fallback: if the user forgot to set their editor anywhere, provide a smart default (nano)
if [ -z "${_LAZY_EDITOR:-${EDITOR:-${VISUAL:-}}}" ]; then
    export _LAZY_EDITOR="nano"
fi

_LAZY_EDITOR_NAME="${_LAZY_EDITOR:-${EDITOR:-${VISUAL:-vi}}}"
_LAZY_EDITOR_NAME="${_LAZY_EDITOR_NAME%% *}"

# Helper function to safely evaluate paths and trigger sudo -e when leaving $HOME
_lazy_smart_open() {
    local real_home abs_target
    real_home="$(realpath -m "$HOME" 2>/dev/null || echo "$HOME")"
    abs_target="$(realpath -m "$1" 2>/dev/null || echo "$1")"

    case "$abs_target" in
        "$real_home"|"$real_home"/*) 
            command ${_LAZY_EDITOR:-${EDITOR:-vi}} "$@" 
            ;;
        *) 
            command sudo -e "$@" 
            ;;
    esac
}

_lazy() {
    # 1. Help menu
    case "$1" in
        help|-h|--help)
            local cmd="${_LAZY_CMD:-lazy}"
            cat <<EOF
$cmd - frecency-based smart cd and editor launcher

USAGE
  $cmd help            show this help
  cd foo               falls back to smart directory jump
  $_LAZY_EDITOR_NAME foo               falls back to smart file open (auto-escalates if outside \$HOME)

TUNABLES (export these in .bashrc/.zshrc before sourcing $cmd)
  _LAZY_CMD               command name to alias '_lazy' to (default: lazy)
  _LAZY_DIR_DATA          directory datafile path (default: ~/.lazydir)
  _LAZY_FILE_DATA         file datafile path (default: ~/.lazyfile)
  _LAZY_MAX_SCORE         aging threshold before scores decay (default: 9000)
  _LAZY_EDITOR            program used to open matched files (default: \$EDITOR, else vi)
EOF
            return
            ;;
    esac

    local dirfile="${_LAZY_DIR_DATA:-$HOME/.lazydir}"
    local filefile="${_LAZY_FILE_DATA:-$HOME/.lazyfile}"

    [ -h "$dirfile" ] && dirfile=$(realpath "$dirfile")
    [ -h "$filefile" ] && filefile=$(realpath "$filefile")

    local mode=""

    _lazy_read () {
        local f="$1" type="$2" line p
        [ -f "$f" ] || return 0
        # Fix #2: Added -r to prevent backslash corruption
        while read -r line; do
            p="${line%%\|*}"
            if [ "$type" = "d" ]; then
                [ -d "$p" ] && echo "$line"
            else
                [ -f "$p" ] && echo "$line"
            fi
        done < "$f"
        return 0
    }

    _lazy_entries () {
        case "$mode" in
            file) _lazy_read "$filefile" f;;
            dir)  _lazy_read "$dirfile" d;;
        esac
    }

    # 2. Add entry (Actively self-cleans dead paths via _lazy_read filter)
    if [ "$1" = "--add" ]; then
        shift
        local abs_path
        abs_path="$(realpath -m "$*" 2>/dev/null || echo "$*")"
        
        [ "$abs_path" = "$HOME" -o "$abs_path" = '/' ] && return

        local target type
        if [ -d "$abs_path" ]; then
            target="$dirfile"; type=d
        elif [ -f "$abs_path" ]; then
            target="$filefile"; type=f
        else
            return
        fi

        local tempfile="$target.$RANDOM"
        local score=${_LAZY_MAX_SCORE:-9000}
        _lazy_read "$target" "$type" | \awk -v path="$abs_path" -v now="$(\date +%s)" -v score=$score -F"|" '
            BEGIN {
                rank[path] = 1
                time[path] = now
            }
            $2 >= 1 {
                if( $1 == path ) {
                    rank[$1] = $2 + 1
                    time[$1] = now
                } else {
                    rank[$1] = $2
                    time[$1] = $3
                }
                count += $2
            }
            END {
                if( count > score ) {
                    for( x in rank ) print x "|" 0.99*rank[x] "|" time[x]
                } else for( x in rank ) print x "|" rank[x] "|" time[x]
            }
        ' 2>/dev/null >| "$tempfile"

        if [ $? -ne 0 -a -f "$target" ]; then
            \env rm -f "$tempfile"
        else
            \env mv -f "$tempfile" "$target" || \env rm -f "$tempfile"
        fi

    # 3. Tab completion
    elif [ "$1" = "--complete" -a \( -s "$dirfile" -o -s "$filefile" \) ]; then
        local complline="$2" firstword
        firstword="${complline%% *}"
        case "$firstword" in
            cd) mode="dir";;
            "$_LAZY_EDITOR_NAME") mode="file";;
            *) return;; 
        esac
        
        local query="${complline#"$firstword" }"
        case "$query" in */*) return;; esac 

        _lazy_entries | \awk -v q="$query" -F"|" '
            BEGIN {
                if( q == tolower(q) ) imatch = 1
                # Basic escape for literal awk regex translation
                gsub(/\\./, "\\.", q)
                gsub(/ /, ".*", q)
            }
            {
                if( imatch ) {
                    if( tolower($1) ~ q ) print $1
                } else if( $1 ~ q ) print $1
            }
        ' 2>/dev/null

    # 4. Search and Go
    else
        case "$1" in
            file) mode="file"; shift;;
            dir)  mode="dir"; shift;;
            *) return 1;; 
        esac

        local fnd="$*"
        [ -n "$fnd" ] || return 1

        case "$mode" in
            file) [ -f "$filefile" ] || return 1;;
            dir)  [ -f "$dirfile" ] || return 1;;
        esac

        local target_path
        target_path="$( < <( _lazy_entries ) \awk -v t="$(\date +%s)" -v q="$fnd" -F"|" '
            function frecent(rank, time) {
              dx = t - time
              return int(10000 * rank * (3.75/((0.0001 * dx + 1) + 0.25)))
            }
            BEGIN {
                gsub(/\\./, "\\.", q)
                gsub(" ", ".*", q)
                hi_rank = ihi_rank = -9999999999
            }
            {
                rank = frecent($2, $3)
                if( $1 ~ q ) {
                    if( rank > hi_rank ) { best_match = $1; hi_rank = rank }
                } else if( tolower($1) ~ tolower(q) ) {
                    if( rank > ihi_rank ) { ibest_match = $1; ihi_rank = rank }
                }
            }
            END {
                if( best_match ) { print best_match; exit }
                if( ibest_match ) { print ibest_match; exit }
                exit(1)
            }
        ')"
        
        local awk_ret=$?

        if [ "$awk_ret" -eq 0 ] && [ -n "$target_path" ]; then
            if [ "$mode" = "dir" ] && [ -d "$target_path" ]; then
                builtin cd "$target_path"
                return 0
            elif [ "$mode" = "file" ] && [ -f "$target_path" ]; then
                (_lazy --add "$target_path" &)
                _lazy_smart_open "$target_path"
                return 0
            fi
        fi
        
        return 1
    fi
}

alias ${_LAZY_CMD:-lazy}='_lazy 2>&1'

if type compctl >/dev/null 2>&1; then
    # zsh
    _lazy_precmd() { (_lazy --add "${PWD:A}" &); : $RANDOM; }
    [[ -n "${precmd_functions[(r)_lazy_precmd]}" ]] || {
        precmd_functions[$(($#precmd_functions+1))]=_lazy_precmd
    }
    _lazy_zsh_tab_completion() {
        local compl
        read -l compl
        reply=(${(f)"$(_lazy --complete "$compl")"})
    }
    compctl -U -K _lazy_zsh_tab_completion cd
    compctl -U -K _lazy_zsh_tab_completion "$_LAZY_EDITOR_NAME"
elif type complete >/dev/null 2>&1; then
    # bash
    complete -o filenames -o dirnames -o bashdefault -o default -C '_lazy --complete "$COMP_LINE"' cd
    complete -o filenames -o bashdefault -o default -C '_lazy --complete "$COMP_LINE"' "$_LAZY_EDITOR_NAME"
    grep "_lazy --add" <<< "$PROMPT_COMMAND" >/dev/null || {
        PROMPT_COMMAND="$PROMPT_COMMAND"$'\n''(_lazy --add "$(command pwd -P 2>/dev/null)" 2>/dev/null &);'
    }
fi

cd() {
    if [ $# -eq 0 ]; then
        builtin cd "$HOME" || return
    elif [ -d "$1" ] || [ "$1" = "-" ]; then
        builtin cd "$@" || return
    else
        _lazy dir "$@" || builtin cd "$@"
    fi
}

eval "
${_LAZY_EDITOR_NAME}() {
    # Fix #6: Bypass fuzzy logic entirely if opening multiple files
    if [ \$# -gt 1 ]; then
        _lazy_smart_open \"\$@\"
        return
    fi

    if [ -f \"\$1\" ] || [[ \"\$1\" == */* ]]; then
        local abs_path
        abs_path=\"\$(realpath -m \"\$1\" 2>/dev/null || echo \"\$1\")\"
        
        [ -f \"\$1\" ] && (_lazy --add \"\$abs_path\" &)
        _lazy_smart_open \"\$@\"
    else
        _lazy file \"\$@\" || {
            _lazy_smart_open \"\$@\"
        }
    fi
}
"
