# No awk/sed/gsub, no floating point math, this makes use of bash's math

shopt -s extglob

readonly _LAZY_REAL_HOME="$(realpath -m "$HOME" 2>/dev/null || echo "$HOME")"
readonly dirfile="$(realpath -m "${_LAZY_DIR_DATA:-$_LAZY_REAL_HOME/.lazydir}" 2>/dev/null || echo "${_LAZY_DIR_DATA:-$_LAZY_REAL_HOME/.lazydir}")"
readonly filefile="$(realpath -m "${_LAZY_FILE_DATA:-$_LAZY_REAL_HOME/.lazyfile}" 2>/dev/null || echo "${_LAZY_FILE_DATA:-$_LAZY_REAL_HOME/.lazyfile}")"

[ -d "$dirfile" ] && { echo "ERROR: lazy's dir datafile ($dirfile) is a directory."; return 1; }
[ -d "$filefile" ] && { echo "ERROR: lazy's file datafile ($filefile) is a directory."; return 1; }

export EDITOR="${EDITOR:-${VISUAL:-nano}}"
export VISUAL="$EDITOR"
_LAZY_EDITOR_NAME="${EDITOR%% *}"
_LAZY_EDITOR_NAME="${_LAZY_EDITOR_NAME##*/}"
readonly _LAZY_EDITOR_NAME

_LAZY_DIR_BLACKLIST="${_LAZY_DIR_BLACKLIST:-!($_LAZY_REAL_HOME/*)}"
_LAZY_FILE_BLACKLIST="${_LAZY_FILE_BLACKLIST:-!($_LAZY_REAL_HOME/*)}"

lazy() {
        echo "lazy - frecency-based smart cd and editor launcher

USAGE
  lazy help            show this help
  cd foo               falls back to smart directory jump
  $_LAZY_EDITOR_NAME foo               falls back to smart file open (auto-escalates if outside \$HOME)

TUNABLES (export these in .bashrc before sourcing lazy)
  _LAZY_DIR_DATA          directory datafile path (default: ~/.lazydir)
  _LAZY_FILE_DATA         file datafile path (default: ~/.lazyfile)
  _LAZY_MAX_SCORE         aging threshold before scores decay (default: 9000)
  _LAZY_DIR_BLACKLIST     colon-separated glob patterns to ignore for cd (default: !(\$HOME/*))
  _LAZY_FILE_BLACKLIST    colon-separated glob patterns to ignore for editor (default: !(\$HOME/*))
  EDITOR                  program used to open matched files (default: nano)"
        return
}

_lazy_smart_open() {
    local abs_target="$(realpath -m "$1" 2>/dev/null || echo "$1")"
    local -a _lazy_editor_cmd=($EDITOR)
    
    [ -d "$abs_target" ] && { echo "Hold up, '$abs_target' is a directory! Use cd instead."; return 1; }

    if [ -e "$abs_target" ]; then
        if [ -w "$abs_target" ]; then
            command "${_lazy_editor_cmd[@]}" "$@"
        else
            command sudo -e "$@"
        fi
    else
        if [ -w "$(dirname "$abs_target")" ]; then
            command "${_lazy_editor_cmd[@]}" "$@"
        else
            command sudo "${_lazy_editor_cmd[@]}" "$@"
        fi
    fi
}

_lazy_is_blacklisted() {
    [[ -z "$1" ]] && return 1
    local pattern
    while IFS= read -r pattern; do
        [[ -z "$pattern" ]] && continue
        [[ "$2" == $pattern ]] && return 0
    done <<< "${1//:/$'\n'}"
    return 1
}

_lazy_add() {
    local abs_path="$2" tempfile="$1.$RANDOM" total_count=0 found=0 path rank time flag="-f"
    [[ "$1" == "$dirfile" ]] && flag="-d"
    local -a lines=()

    if [ -f "$1" ]; then
        while IFS="|" read -r path rank time; do
            [ -z "$path" ] && continue
            [ $flag "$path" ] || continue

            [[ "$path" == "$abs_path" ]] && (( rank++, found=1 )) && time=$(command date +%s)

            lines+=("$path|$rank|$time")
            (( total_count += rank ))
        done < "$1"
    fi

    [[ $found -eq 0 ]] && lines+=("$abs_path|1|$(command date +%s)")
    (( total_count++ ))

    if [[ $total_count -gt ${_LAZY_MAX_SCORE:-9000} ]]; then
        printf "%s\n" "${lines[@]}" | while IFS="|" read -r path rank time; do
            [[ "$path" != "$abs_path" ]] && (( rank = (rank * 99) / 100 ))
            [[ $rank -gt 0 ]] && echo "$path|$rank|$time"
        done > "$tempfile"
    else
        printf "%s\n" "${lines[@]}" > "$tempfile"
    fi

    if [[ -s "$tempfile" ]]; then
        \env mv -f "$tempfile" "$1"
    else
        \env rm -f "$tempfile"
    fi
}

_lazy_complete_func() {
    local target="$filefile"
    [[ "$1" == "cd" ]] && { (( COMP_CWORD > 1 )) && return 0; target="$dirfile"; }

    COMPREPLY=()
    local path rank time added_abs_paths=$'\n'
    
    if [ -s "$target" ] && [[ "$2" != */* ]]; then
        local q_frecency="${2// /*}"
        local q_lower="${q_frecency,,}"

        while IFS="|" read -r path rank time; do
            [ -z "$path" ] && continue
            
            if [[ "$q_frecency" == "$q_lower" && "${path,,}" == *"$q_lower"* ]] || \
               [[ "$q_frecency" != "$q_lower" && "$path" == *"$q_frecency"* ]]; then
                COMPREPLY+=("$path")
                added_abs_paths+="${path}"$'\n'
            fi
        done < "$target"
    fi

    local local_path abs_local_path
    while IFS= read -r local_path; do
        [ -z "$local_path" ] && continue
        abs_local_path="$local_path"
        [[ "$local_path" != /* ]] && abs_local_path="$PWD/$local_path"
        
        if [[ "$added_abs_paths" != *$'\n'"$abs_local_path"$'\n'* ]]; then
            COMPREPLY+=("$local_path")
            added_abs_paths+="${abs_local_path}"$'\n'
        fi
    done < <( if [ "$target" = "$dirfile" ]; then compgen -d -- "$2"; else compgen -f -- "$2"; fi )
}

_lazy_search() {
    [ -z "$2" ] && return 1
    [ -f "$1" ] || return 1

    local now=$(date +%s) hi_rank=-9999999999 ihi_rank=-9999999999 best_match="" ibest_match="" path rank time
    local q="${*:2}"
    q="${q// /*}"
    local q_lower="${q,,}"

    while IFS="|" read -r path rank time; do
        [ -z "$path" ] && continue

        if [[ "${path,,}" == *"$q_lower"* ]]; then
            local current_rank=$(( (375000000 * rank) / (now - time + 12500) ))
            
            if [[ "$q" == "$q_lower" ]] || [[ "$path" == *"$q"* ]]; then
                (( current_rank > hi_rank )) && hi_rank=$current_rank && best_match="$path"
            else
                (( current_rank > ihi_rank )) && ihi_rank=$current_rank && ibest_match="$path"
            fi
        fi
    done < "$1"

    local final_match="${best_match:-$ibest_match}"
    if [ -n "$final_match" ]; then
        echo "$final_match"
        return 0
    fi
    return 1
}

complete -o nosort -o filenames -o dirnames -o bashdefault -o default -F _lazy_complete_func cd
complete -o nosort -o filenames -o bashdefault -o default -F _lazy_complete_func "$_LAZY_EDITOR_NAME"

cd() {
    local old_pwd="$(command pwd -P 2>/dev/null)"
    if [ $# -eq 0 ]; then
        builtin cd || return
    elif [[ "$1" == "-" ]] || [ -d "$1" ]; then
        builtin cd "$@" || return
    else
        local target_path=$(_lazy_search "$dirfile" "$@")
        [ -d "$target_path" ] && builtin cd "$target_path" || builtin cd "$@" || return
    fi
    local new_pwd="$(command pwd -P 2>/dev/null)"

    if [[ "$-" == *i* ]] && [[ "$old_pwd" != "$new_pwd" ]] && ! _lazy_is_blacklisted "$_LAZY_DIR_BLACKLIST" "$new_pwd"; then
        (_lazy_add "$dirfile" "$new_pwd" 2>/dev/null &)
    fi
}

eval "
${_LAZY_EDITOR_NAME}() {
    [ \$# -eq 0 ] && { command \${EDITOR} ; return ; }
    for target in \"\$@\"; do
		local absolute_path=\"\"
		if [[ \"\$target\" != */* ]] && [ ! -f \"\$target\" ]; then
			absolute_path=\$(_lazy_search \"\$filefile\" \"\$target\")
			[ -f \"\$absolute_path\" ] && target=\"\$absolute_path\"
		fi
               
		[[ \"\$target\" != \"\$absolute_path\" ]] && absolute_path=\"\$(realpath -m \"\$target\" 2>/dev/null || echo \"\$target\")\"
               
		if ! _lazy_is_blacklisted \"\$_LAZY_FILE_BLACKLIST\" \"\$absolute_path\"; then
			[ -f \"\$absolute_path\" ] && (_lazy_add \"\$filefile\" \"\$absolute_path\" &)
		fi
		_lazy_smart_open \"\$target\"
    done
}"
