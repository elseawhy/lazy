dirfile="${_LAZY_DIR_DATA:-$HOME/.lazydir}"
filefile="${_LAZY_FILE_DATA:-$HOME/.lazyfile}"

[ -h "$dirfile" ] && dirfile="$(realpath -m "$dirfile" 2>/dev/null || readlink "$dirfile")"
[ -h "$filefile" ] && filefile="$(realpath -m "$filefile" 2>/dev/null || readlink "$filefile")"

readonly dirfile filefile

for f in "$dirfile" "$filefile"; do
    [ -d "$f" ] && { echo "ERROR: lazy datafile ($f) is a directory."; return 1 2>/dev/null || exit 1; }
done

export EDITOR="${EDITOR:-${VISUAL:-nano}}"
export VISUAL="$EDITOR"
_LAZY_EDITOR_NAME="${EDITOR%% *}"
_LAZY_EDITOR_NAME="${_LAZY_EDITOR_NAME##*/}"
readonly _LAZY_EDITOR_NAME
readonly _LAZY_REAL_HOME="$(realpath -m "$HOME" 2>/dev/null || echo "$HOME")"

lazy() {
        echo "lazy - frecency-based smart cd and editor launcher

USAGE
  lazy help            show this help
  cd foo               falls back to smart directory jump
  $_LAZY_EDITOR_NAME foo               falls back to smart file open (auto-escalates if outside \$HOME)

TUNABLES (export these in .bashrc before sourcing lazy)
  _LAZY_DIR_DATA          directory datafile path (default: ~/.lazydir)
  _LAZY_FILE_DATA         file datafile path (default: ~/.lazyfile)
  _LAZY_MAX_SCORE         aging threshold before scores decay (default: 9000)
  EDITOR                  program used to open matched files (default: nano)"
        return
}

_lazy_smart_open() {
    local existed=0 abs_target="$(realpath -m "$1" 2>/dev/null || echo "$1")"
    local -a _lazy_editor_cmd=($EDITOR)
    
    [ -e "$abs_target" ] && existed=1
    [ -d "$abs_target" ] && { echo "Hold up, '$abs_target' is a directory! Use cd instead."; return 1; }

    case "$abs_target" in
        "$_LAZY_REAL_HOME"|"$_LAZY_REAL_HOME"/*) command "${_lazy_editor_cmd[@]}" "$@" ;;
        *) case "$existed" in
                1) command sudo -e "$@" ;;
                *) command sudo "${_lazy_editor_cmd[@]}" "$@" ;;
           esac ;;
    esac
}

_lazy_add() {
    local target="$1" abs_path="$(realpath -m "$2" 2>/dev/null || echo "$2")"
    local tempfile=$(mktemp "$target.XXXXXX") score=${_LAZY_MAX_SCORE:-9000} now=$(date +%s) total_count=0 found=0 p r t
    local -a lines=()

    if [ -f "$target" ]; then
        while IFS="|" read -r p r t; do
            [ -z "$p" ] && continue
            
	    case "$target" in
	        "$dirfile") [ -d "$p" ] || continue ;;
			"$filefile") [ -f "$p" ] || continue ;;
	    esac

            case "$p" in
                "$abs_path")
                    r=$((r + 1))
                    t=$now
                    found=1 ;;
            esac
            
            lines+=("$p|$r|$t")
            total_count=$((total_count + r))
        done < "$target"
    fi

    if [ "$found" -eq 0 ]; then
        lines+=("$abs_path|1|$now")
        total_count=$((total_count + 1))
    fi

    if [[ $total_count -gt $score ]]; then
        for line in "${lines[@]}"; do
            IFS="|" read -r p r t <<< "$line"
            if [[ "$p" == "$abs_path" ]]; then
                 echo "$p|$r|$t" >> "$tempfile"
            else
                r=$(( (r * 99) / 100 ))
                [[ $r -gt 0 ]] && echo "$p|$r|$t" >> "$tempfile"
            fi
        done
    else
        printf "%s\n" "${lines[@]}" > "$tempfile"
    fi

    if [[ -s "$tempfile" ]]; then
        \env mv -f "$tempfile" "$target"
    else
        \env rm -f "$tempfile"
    fi
}

_lazy_complete_func() {
    local target p r t imatch=0

    case "$1" in
        cd) (( COMP_CWORD > 1 )) && return 0
	    target="$dirfile" ;;
        "$_LAZY_EDITOR_NAME") target="$filefile" ;;
        *) return 0 ;;
    esac

    [ -s "$target" ] || return 0
    case "$2" in */*) return 0 ;; esac

    local q="${2// /*}"
    local q_lower="${q,,}"
    case "$q" in "$q_lower") imatch=1 ;; esac

    COMPREPLY=()
    
    while IFS="|" read -r p r t; do
        [ -z "$p" ] && continue
        case "$imatch" in
            1) case "${p,,}" in *"$q_lower"*) COMPREPLY+=("$p") ;; esac ;;
            *) case "$p" in *"$q"*) COMPREPLY+=("$p") ;; esac ;;
        esac
    done < "$target"
}

_lazy_search() {
    local target_db="$1"
    shift
    local fnd="$*"
    
    [ -z "$fnd" ] && return 1
    [ -f "$target_db" ] || return 1

    local now=$(date +%s) hi_rank=-9999999999 ihi_rank=-9999999999 best_match="" ibest_match="" p r t q="${fnd// /*}"
    local q_lower="${q,,}"

    while IFS="|" read -r p r t; do
        [ -z "$p" ] && continue
        local dx=$(( now - t ))
        local current_rank=$(( (375000000 * r) / (dx + 12500) ))

        case "$p" in
            *"$q"*) (( current_rank > hi_rank )) && hi_rank=$current_rank && best_match="$p" ;;
            *) case "${p,,}" in
                    *"$q_lower"*) (( current_rank > ihi_rank )) && ihi_rank=$current_rank && ibest_match="$p" ;;
               esac ;;
        esac
    done < "$target_db"

    local final_match="${best_match:-$ibest_match}"
    if [ -n "$final_match" ]; then
        echo "$final_match"
        return 0
    fi
    return 1
}

_lazy_query_dir() {
    local target_path=$(_lazy_search "$dirfile" "$@")
    if [ -d "$target_path" ]; then
        builtin cd "$target_path" && return 0
    fi
    return 1
}

_lazy_query_file() {
    local target_path=$(_lazy_search "$filefile" "$@")
    if [ -f "$target_path" ]; then
        (_lazy_add "$filefile" "$target_path" &)
        _lazy_smart_open "$target_path"
        return 0
    fi
    return 1
}

complete -o filenames -o dirnames -o bashdefault -o default -F _lazy_complete_func cd
complete -o filenames -o bashdefault -o default -F _lazy_complete_func "$_LAZY_EDITOR_NAME"

cd() {
    local old_pwd="$(command pwd -P 2>/dev/null)"
    case $# in
        0) builtin cd || return ;;
        *) case "$1" in
                -) builtin cd "$@" || return ;;
                *) if [ -d "$1" ]; then
                        builtin cd "$@" || return
                   else
                        _lazy_query_dir "$@" || builtin cd "$@"
                   fi ;;
           esac ;;
    esac
    local new_pwd="$(command pwd -P 2>/dev/null)"

    if [[ "$-" == *i* ]] && [[ "$old_pwd" != "$new_pwd" ]]; then
        case "$new_pwd" in
            "$_LAZY_REAL_HOME"|/) ;;
            *) (_lazy_add "$dirfile" "$new_pwd" 2>/dev/null &) ;;
        esac
    fi
}

eval "
${_LAZY_EDITOR_NAME}() {
    case \$# in
        0) command \${EDITOR} ; return ;;
        *) if [[ \"\$1\" == */* ]] || [ -f \"\$1\" ]; then
               local abs_path=\"\$(realpath -m \"\$1\" 2>/dev/null || echo \"\$1\")\"
               [ -f \"\$1\" ] && (_lazy_add \"\$filefile\" \"\$abs_path\" &)
               _lazy_smart_open \"\$1\"
           else
               _lazy_query_file \"\$1\" || _lazy_smart_open \"\$1\"
           fi

           if [ \"\$#\" -gt 1 ]; then
               echo \"I saw you tried to open multiple files.\"
               echo \"I only opened '\$1' so you don't lose track of your buffers!\"
           fi ;;
    esac
}"
