[ -d "${_LAZY_DIR_DATA:-$HOME/.lazydir}" ] && {
    echo "ERROR: lazy's directory datafile (${_LAZY_DIR_DATA:-$HOME/.lazydir}) is a directory."
    return 1 2>/dev/null || exit 1
}
[ -d "${_LAZY_FILE_DATA:-$HOME/.lazyfile}" ] && {
    echo "ERROR: lazy's file datafile (${_LAZY_FILE_DATA:-$HOME/.lazyfile}) is a directory."
    return 1 2>/dev/null || exit 1
}

case "${_LAZY_EDITOR:-${EDITOR:-${VISUAL:-}}}" in
    "") export _LAZY_EDITOR="nano" ;;
esac

export EDITOR="${EDITOR:-$_LAZY_EDITOR}"
export VISUAL="${VISUAL:-$_LAZY_EDITOR}"

_LAZY_EDITOR_NAME="${_LAZY_EDITOR:-${EDITOR:-${VISUAL:-vi}}}"
_LAZY_EDITOR_NAME="${_LAZY_EDITOR_NAME%% *}"
_LAZY_EDITOR_NAME="${_LAZY_EDITOR_NAME##*/}"
_LAZY_REAL_HOME="$(realpath -m "$HOME" 2>/dev/null || echo "$HOME")"
dirfile="${_LAZY_DIR_DATA:-$HOME/.lazydir}"
filefile="${_LAZY_FILE_DATA:-$HOME/.lazyfile}"

lazy() {
        cat <<EOF
lazy - frecency-based smart cd and editor launcher

USAGE
  lazy help            show this help
  cd foo               falls back to smart directory jump
  $_LAZY_EDITOR_NAME foo               falls back to smart file open (auto-escalates if outside \$HOME)

TUNABLES (export these in .bashrc before sourcing $cmd)
  _LAZY_DIR_DATA          directory datafile path (default: ~/.lazydir)
  _LAZY_FILE_DATA         file datafile path (default: ~/.lazyfile)
  _LAZY_MAX_SCORE         aging threshold before scores decay (default: 9000)
  _LAZY_EDITOR            program used to open matched files (default: \$EDITOR, else vi)
EOF
        return
}

_lazy_read () {
    local f="$1" type="$2" line p
    [ -f "$f" ] || return 0
    while IFS= read -r line; do
        p="${line%%\|*}"
        case "$type" in
            d) [ -d "$p" ] && echo "$line" ;;
            f) [ -f "$p" ] && echo "$line" ;;
        esac
    done < "$f"
    return 0
}

_lazy_smart_open() {
    local existed=0
    local abs_target="$(realpath -m "$1" 2>/dev/null || echo "$1")"
    [ -e "$abs_target" ] && existed=1

    local -a _lazy_editor_cmd=(${_LAZY_EDITOR:-${EDITOR:-${VISUAL:-vi}}})

    if [ -d "$abs_target" ]; then
	echo "Hold up, '$abs_target' is a directory! Use cd instead."
	return 1
    fi

    case "$abs_target" in
        "$_LAZY_REAL_HOME"|"$_LAZY_REAL_HOME"/*) command "${_lazy_editor_cmd[@]}" "$@" ;;
        *) case "$existed" in
                1) command sudo -e "$@" ;;
                *) command sudo "${_lazy_editor_cmd[@]}" "$@" ;;
           esac ;;
    esac
}

_lazy_add() {
    [ -h "$dirfile" ] && dirfile=$(realpath -m "$dirfile" 2>/dev/null || echo "$dirfile")
    [ -h "$filefile" ] && filefile=$(realpath -m "$filefile" 2>/dev/null || echo "$filefile")

    local abs_path="$(realpath -m "$1" 2>/dev/null || echo "$1")"
    
    if [ -d "$abs_path" ]; then
	target="$dirfile"; type=d
    elif [ -f "$abs_path" ]; then
        target="$filefile"; type=f
    else
	return
    fi

    local tempfile=$(mktemp "$target.XXXXXX")
    local score=${_LAZY_MAX_SCORE:-9000}
    local now=$(date +%s)
    local total_count=0
    local found=0
    local -a lines=()
    local p r t

    while IFS="|" read -r p r t; do
	[ -z "$p" ] && continue
	case "$p" in
		"$abs_path")
                r=$((r + 1))
                t=$now
                found=1 ;;
        esac
	lines+=("$p|$r|$t")
        total_count=$((total_count + r))
    done < <(_lazy_read "$target" "$type")

    case "$found" in
        0) lines+=("$abs_path|1|$now")
           total_count=$((total_count + 1)) ;;
    esac

    if [[ $total_count -gt $score ]]; then
        for line in "${lines[@]}"; do
        	IFS="|" read -r p r t <<< "$line"
		if [[ "$p" == "$abs_path" ]]; then
			 echo "$p|$r|$t" >> "$tempfile"
		else
			r=$(( (r * 99) / 100 ))
			[[ $r -gt 0 ]] && echo "$p|$r|$t" >> "$tempfile"
		fi
	done
    else
        printf "%s\n" "${lines[@]}" > "$tempfile"
    fi

    if [[ -s "$tempfile" ]]; then
        \env mv -f "$tempfile" "$target"
    else
        \env rm -f "$tempfile"
    fi
}

_lazy_complete() {
    [ -s "$dirfile" ] || [ -s "$filefile" ] || return 0

    local complline="$1"
    local firstword="${complline%% *}"
    local target typechar
    case "$firstword" in
        cd) target="$dirfile"; typechar=d ;;
        "$_LAZY_EDITOR_NAME") target="$filefile"; typechar=f ;;
        *) return ;;
    esac

    local query="${complline#"$firstword" }"
    case "$query" in */*) return ;; esac
    local q="${query// /*}"
    local q_lower="${q,,}"
    local p r t
    local imatch=0
    case "$q" in "$q_lower") imatch=1 ;; esac

    while IFS="|" read -r p r t; do
        [ -z "$p" ] && continue
        case "$imatch" in
            1) case "${p,,}" in *"$q_lower"*) echo "$p" ;; esac ;;
            *) case "$p" in *"$q"*) echo "$p" ;; esac ;;
        esac
    done < <(_lazy_read "$target" "$typechar")
}

_lazy_search() {
    local target_db="$1"
    shift
    local fnd="$*"
    
    [ -z "$fnd" ] && return 1
    [ -f "$target_db" ] || return 1

    local now=$(date +%s)
    local q="${fnd// /*}"
    local q_lower="${q,,}"
    local hi_rank=-9999999999
    local ihi_rank=-9999999999
    local best_match=""
    local ibest_match=""
    local p r t

    while IFS="|" read -r p r t; do
        [ -z "$p" ] && continue
        local dx=$(( now - t ))
        local current_rank=$(( (375000000 * r) / (dx + 12500) ))

        case "$p" in
            *"$q"*) (( current_rank > hi_rank )) && hi_rank=$current_rank && best_match="$p" ;;
            *) case "${p,,}" in
                    *"$q_lower"*) (( current_rank > ihi_rank )) && ihi_rank=$current_rank && ibest_match="$p" ;;
               esac ;;
        esac
    done < "$target_db"

    local final_match="${best_match:-$ibest_match}"
    if [ -n "$final_match" ]; then
        echo "$final_match"
        return 0
    fi
    return 1
}

_lazy_query_dir() {
    local target_path
    target_path=$(_lazy_search "$dirfile" "$@")
    
    if [ $? -eq 0 ] && [ -d "$target_path" ]; then
        builtin cd "$target_path" && return 0
    fi
    return 1
}

_lazy_query_file() {
    local target_path
    target_path=$(_lazy_search "$filefile" "$@")
    
    if [ $? -eq 0 ] && [ -f "$target_path" ]; then
        (_lazy_add "$target_path" &)
        _lazy_smart_open "$target_path"
        return 0
    fi
    return 1
}

complete -o filenames -o dirnames -o bashdefault -o default -C '_lazy_complete "$COMP_LINE"' cd
complete -o filenames -o bashdefault -o default -C '_lazy_complete "$COMP_LINE"' "$_LAZY_EDITOR_NAME"

cd() {
    local old_pwd="$(command pwd -P 2>/dev/null)"
    case $# in
        0) builtin cd "$HOME" || return ;;
        *) case "$1" in
                -) builtin cd "$@" || return ;;
                *) if [ -d "$1" ]; then
                        builtin cd "$@" || return
                   else
                        _lazy_query_dir "$@" || builtin cd "$@"
                   fi ;;
           esac ;;
    esac
    local new_pwd="$(command pwd -P 2>/dev/null)"

    if [[ "$-" == *i* ]] && [[ "$old_pwd" != "$new_pwd" ]]; then
        case "$new_pwd" in
            "$HOME"|/) ;;
            *) (_lazy_add "$new_pwd" 2>/dev/null &) ;;
        esac
    fi
}

eval "
${_LAZY_EDITOR_NAME}() {
    case \$# in
        0) command \${_LAZY_EDITOR:-\${EDITOR:-\${VISUAL:-vi}}} ; return ;;
        *) case \"\$1\" in
                */*) local abs_path=\"\$(realpath -m \"\$1\" 2>/dev/null || echo \"\$1\")\"
                     [ -f \"\$1\" ] && (_lazy_add \"\$abs_path\" &)
                     _lazy_smart_open \"\$1\" ;;
                *) if [ -f \"\$1\" ]; then
                        local abs_path=\"\$(realpath -m \"\$1\" 2>/dev/null || echo \"\$1\")\"
                        (_lazy_add \"\$abs_path\" &)
                        _lazy_smart_open \"\$1\"
                   else
                        _lazy_query_file \"\$1\" || _lazy_smart_open \"\$1\"
                   fi ;;
           esac
	   if [ \"\$#\" -gt 1 ]; then
		echo \"I saw you tried to open multiple files.\"
                echo \"I only opened '\$1' so you don't lose track of your buffers!\"
           fi
	   ;;
    esac
}"
