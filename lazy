_LAZY_REAL_HOME="$(realpath -m "$HOME" 2>/dev/null || echo "$HOME")"
_LAZY_DIR_DB="$(realpath -m "${_LAZY_DIR_DB:-$_LAZY_REAL_HOME/.lazydir}" 2>/dev/null || echo "${_LAZY_DIR_DB:-$_LAZY_REAL_HOME/.lazydir}")"
_LAZY_FILE_DB="$(realpath -m "${_LAZY_FILE_DB:-$_LAZY_REAL_HOME/.lazyfile}" 2>/dev/null || echo "${_LAZY_FILE_DB:-$_LAZY_REAL_HOME/.lazyfile}")"

[[ -d "$_LAZY_DIR_DB" ]] && { echo "ERROR: lazy's dir datafile ($_LAZY_DIR_DB) is a directory."; return 1; }
[[ -d "$_LAZY_FILE_DB" ]] && { echo "ERROR: lazy's file datafile ($_LAZY_FILE_DB) is a directory."; return 1; }

export EDITOR="${EDITOR:-${VISUAL:-nano}}"
export VISUAL="$EDITOR"
_LAZY_EDITOR="${EDITOR%% *}"
_LAZY_EDITOR="${_LAZY_EDITOR##*/}"
alias "$_LAZY_EDITOR"='_lazy_editor_wrapper'

lazy() {
    printf "lazy - frecency-based smart cd and editor launcher\n\n\
USAGE\n\
  %-21s%s\n\
  %-21s%s\n\
  %-21s%s\n\n\
TUNABLES (initialize these in .bashrc before sourcing lazy)\n\
  _LAZY_DIR_DB            directory datafile path (default: ~/.lazydir)\n\
  _LAZY_FILE_DB           file datafile path (default: ~/.lazyfile)\n\
  _LAZY_DIR_BLACKLIST     array of path prefixes to ignore for cd (default: empty)\n\
  _LAZY_FILE_BLACKLIST    array of path prefixes to ignore for editor (default: empty)\n\
  _LAZY_HALF_LIFE         commands until score halves (default: 85)\n\
  _LAZY_MAX_ENTRIES       maximum number of entries to track per file (default: 1000)\n\
  EDITOR                  program used to open matched files (default: nano)\n\n\
CURRENT STATS\n\
  %-24s%s\n\
  %-24s%s\n\
  %-24s%s\n" \
        "lazy" "show this help" \
        "cd foo" "falls back to smart directory jump" \
        "${_LAZY_EDITOR} foo" "falls back to smart file open (auto-escalates if outside \$HOME)" \
        "Half-Life" "${_LAZY_HALF_LIFE:-85} commands" \
        "Maximum Entries" "${_LAZY_MAX_ENTRIES:-1000}" \
        "Maximum possible score" "$(awk -v H="${_LAZY_HALF_LIFE:-85}" 'BEGIN { printf "%.1f", 1 / (1 - (0.5 ^ (1 / H))) }')"
}

_lazy_write() {
    [[ ! "$1" =~ ^($_LAZY_DIR_DB|$_LAZY_FILE_DB)$ || ! "$2" =~ ^-(d|f)$ || -z "$3" ]] && return 1
    [[ "$3" != "$_LAZY_REAL_HOME/"* ]] && return 0

    local blacklist
    for blacklist in "${@:4}"; do
        [[ -n "$blacklist" && "$3" == "$blacklist"* ]] && return 0
    done

    [[ -f "$1" ]] || touch "$1" 2>/dev/null || return 1
    local tempfile="$(mktemp "${1}.XXXXXX")"
    
    while IFS="|" read -r path rest; do
        [ $2 "$path" ] && echo "$path|$rest"
    done < "$1" 2>/dev/null | awk -F"|" -v target="$3" -v H="${_LAZY_HALF_LIFE:-85}" '
        BEGIN { OFS="|"; OFMT="%.17g"; CONVFMT="%.17g"; decay = 2 ^ (1 / H) }
        {
            if ($1 == target) {
                found = 1
                print $1, ($2 / decay) + 1
            } else print $1, $2 / decay
        }
        END { if (!found) print target, 1 }
    ' | LC_ALL=C sort -t'|' -k2,2gr -k1,1 | head -n "${_LAZY_MAX_ENTRIES:-1000}" > "$tempfile"

    if [[ -s "$tempfile" ]]; then
    	\env mv -f "$tempfile" "$1"
	else
    	\env rm -f "$tempfile"
	fi
}

_lazy_read() {
    [[ -z "$2" || ! -f "$1" ]] && return 1
    awk -F"|" -v query="${*:2}" '
        BEGIN {
            gsub(/ /, ".*", query)
            lower_query = tolower(query)
            case_sensitive = (query != lower_query)
            if (!case_sensitive) query = lower_query
        }
        {
            if ($1 == "") next
            base = parts[split($1, parts, "/")]
            candidate = case_sensitive ? base : tolower(base)
            if (candidate ~ query) {
                print $1
                found = 1
                exit 0
            }
        }
        END { if (!found) exit 1 }
    ' "$1"
}

[[ -n "${BASH_VERSION-}" ]] && {
    _lazy_complete_func() {
        [[ -z "${COMP_LINE+x}" ]] && return 1
        
        local target="$_LAZY_FILE_DB" comp_opt="-f" path abs_path rest
        [[ "$1" == "cd" ]] && {
        	(( COMP_CWORD > 1 )) && return 0
        	target="$_LAZY_DIR_DB"
        	comp_opt="-d"
        }
        
        COMPREPLY=()
        local -A seen_paths
        
        [[ -s "$target" && "$2" != */* ]] && {
            local pattern="${2// /*}" local_nocase=0
            [[ "$pattern" == "${pattern,,}" ]] && { 
            	shopt -q nocasematch || {
            		shopt -s nocasematch
            		local_nocase=1
            	}
            }
            while IFS="|" read -r path rest; do
                [[ -n "$path" && "$path" == *"$pattern"* ]] && {
                    COMPREPLY+=("${path/#$_LAZY_REAL_HOME/\~}")
                    seen_paths["$path"]=1
                }
            done < "$target"
            [[ $local_nocase -eq 1 ]] && shopt -u nocasematch
        }
        while IFS= read -r path; do
            [[ -n "$path" ]] && {
            	abs_path="$path"
            	[[ "$path" != /* ]] && abs_path="$PWD/$path"
            	[[ ! -v seen_paths["$abs_path"] ]] && {
                	COMPREPLY+=("$path")
                	seen_paths["$abs_path"]=1
            	}
            }
        done < <(compgen "$comp_opt" -- "$2")
    }
    complete -o nosort -o dirnames -o bashdefault -o default -F _lazy_complete_func cd
    complete -o nosort -o bashdefault -o default -F _lazy_complete_func _lazy_editor_wrapper
}

cd() {
    local old_pwd="$(command pwd -P 2>/dev/null)"
    if [[ $# -eq 0 ]]; then
        builtin cd || return
    else
        [[ "$1" != "-" && ! -d "$*" ]] && set -- "$(_lazy_read "$_LAZY_DIR_DB" "$@" || echo "$*")"
        builtin cd "$*" || return
    fi
    local new_pwd="$(command pwd -P 2>/dev/null)"

    [[ "$-" == *i* && "$old_pwd" != "$new_pwd" ]] && (_lazy_write "$_LAZY_DIR_DB" -d "$new_pwd" ${_LAZY_DIR_BLACKLIST[@]+"${_LAZY_DIR_BLACKLIST[@]}"} 2>/dev/null &)
}

_lazy_editor_wrapper() {
    [[ $# -eq 0 || " $*" == *" "[-+]* ]] && { command ${EDITOR} "$@"; return; }
    
    local target
    local -a exec_cmd
    
    for target in "$@"; do
        exec_cmd=($EDITOR)
        
        [[ "$target" != */* && ! -e "$target" ]] && {
            local match="$(_lazy_read "$_LAZY_FILE_DB" "$target" 2>/dev/null)"
            [[ -n "$match" ]] && target="$match"
        }
        if [[ -f "$target" ]]; then
            [[ "$target" != /* ]] && target="$(realpath -m "$target" 2>/dev/null || echo "$target")"
            (_lazy_write "$_LAZY_FILE_DB" -f "$target" ${_LAZY_FILE_BLACKLIST[@]+"${_LAZY_FILE_BLACKLIST[@]}"} &)
            [[ ! -w "$target" ]] && exec_cmd=(sudo -e)
        else
        	local dname="${target%/*}"
        	[[ "$dname" == "$target" ]] && dname="."
        	[[ ! -d "$dname" ]] && {
        		echo "lazy: directory '$dname' does not exist for target '$target'" >&2
        		continue
        	}
            [[ ! -w "$dname" ]] && exec_cmd=(sudo -e)
        fi
        command "${exec_cmd[@]}" "$target"
    done
}
