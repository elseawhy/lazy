shopt -s extglob

readonly _LAZY_REAL_HOME="$(realpath -m "$HOME" 2>/dev/null || echo "$HOME")"
readonly dirfile="$(realpath -m "${_LAZY_DIR_DATA:-$_LAZY_REAL_HOME/.lazydir}" 2>/dev/null || echo "${_LAZY_DIR_DATA:-$_LAZY_REAL_HOME/.lazydir}")"
readonly filefile="$(realpath -m "${_LAZY_FILE_DATA:-$_LAZY_REAL_HOME/.lazyfile}" 2>/dev/null || echo "${_LAZY_FILE_DATA:-$_LAZY_REAL_HOME/.lazyfile}")"

[[ -d "$dirfile" ]] && { echo "ERROR: lazy's dir datafile ($dirfile) is a directory."; return 1; }
[[ -d "$filefile" ]] && { echo "ERROR: lazy's file datafile ($filefile) is a directory."; return 1; }

export EDITOR="${EDITOR:-${VISUAL:-nano}}"
export VISUAL="$EDITOR"
_LAZY_EDITOR_NAME="${EDITOR%% *}"
_LAZY_EDITOR_NAME="${_LAZY_EDITOR_NAME##*/}"
_LAZY_DIR_BLACKLIST="${_LAZY_DIR_BLACKLIST:-!($_LAZY_REAL_HOME/*)}"
_LAZY_FILE_BLACKLIST="${_LAZY_FILE_BLACKLIST:-!($_LAZY_REAL_HOME/*)}"
readonly _LAZY_EDITOR_NAME _LAZY_DIR_BLACKLIST _LAZY_FILE_BLACKLIST

lazy() {
    printf "lazy - frecency-based smart cd and editor launcher\n\n\
USAGE\n\
  %-21s%s\n\
  %-21s%s\n\
  %-21s%s\n\n\
TUNABLES (initialize these in .bashrc before sourcing lazy)\n\
  _LAZY_DIR_DATA          directory datafile path (default: ~/.lazydir)\n\
  _LAZY_FILE_DATA         file datafile path (default: ~/.lazyfile)\n\
  _LAZY_HALF_LIFE         commands until score halves (default: 85)\n\
  _LAZY_MAX_ENTRIES       maximum number of entries to track per file (default: 1000)\n\
  _LAZY_DIR_BLACKLIST     colon-separated glob patterns to ignore for cd (default: !(\$HOME/*))\n\
  _LAZY_FILE_BLACKLIST    colon-separated glob patterns to ignore for editor (default: !(\$HOME/*))\n\
  EDITOR                  program used to open matched files (default: nano)\n\n\
CURRENT STATS\n\
  %-24s%s\n\
  %-24s%s\n\
  %-24s%s\n" \
        "lazy help" "show this help" \
        "cd foo" "falls back to smart directory jump" \
        "${_LAZY_EDITOR_NAME} foo" "falls back to smart file open (auto-escalates if outside \$HOME)" \
        "Half-Life" "${_LAZY_HALF_LIFE:-85} commands" \
        "Maximum Entries" "${_LAZY_MAX_ENTRIES:-1000}" \
        "Maximum possible score" "$(awk -v H="${_LAZY_HALF_LIFE:-85}" 'BEGIN { printf "%.1f", 1 / (1 - (0.5 ^ (1 / H))) }')"
}

_lazy_is_blacklisted() {
    [[ -z "$1" ]] && return 1
    local pattern
    while IFS= read -r pattern; do
        [[ -z "$pattern" ]] && continue
        [[ "$2" == $pattern ]] && return 0
    done <<< "${1//:/$'\n'}"
    return 1
}

_lazy_write() {
    local tempfile="$1.$RANDOM" flag="-f"
    [[ "$1" == "$dirfile" ]] && flag="-d"
    
    awk -F"|" -v target="$2" -v H="${_LAZY_HALF_LIFE:-85}" '
        BEGIN { OFS="|"; OFMT="%.17g"; CONVFMT="%.17g"; decay = 2 ^ (1 / H) }
        {
            if ($1 == target) {
                found = 1
                print $1, ($2 / decay) + 1
            } else {
                print $1, $2 / decay
            }
        }
        END {
            if (!found) print target, 1
        }
    ' "$1" 2>/dev/null | while IFS="|" read -r path rest; do
        [ $flag "$path" ] && echo "$path|$rest"
    done | LC_ALL=C sort -t'|' -k2,2gr -k1,1 | head -n "${_LAZY_MAX_ENTRIES:-1000}" > "$tempfile"

    if [[ -s "$tempfile" ]]; then
        \env mv -f "$tempfile" "$1"
    else
        \env rm -f "$tempfile"
    fi
}

_lazy_complete_func() {
    local target="$filefile"
    [[ "$1" == "cd" ]] && { (( COMP_CWORD > 1 )) && return 0; target="$dirfile"; }

    COMPREPLY=()
    local path local_path abs_local_path added_abs_paths=$'\n'
    
    if [[ -s "$target" ]] && [[ "$2" != */* ]]; then
        local q_frecency="${2// /*}"
        local q_lower="${q_frecency,,}"

        while IFS="|" read -r path rest; do
            [[ -z "$path" ]] && continue
            if [[ "$q_frecency" == "$q_lower" && "${path,,}" == *"$q_lower"* ]] || \
               [[ "$q_frecency" != "$q_lower" && "$path" == *"$q_frecency"* ]]; then
                COMPREPLY+=("${path/#$_LAZY_REAL_HOME/\~}")
                added_abs_paths+="${path}"$'\n'
            fi
        done < "$target"
    fi

    while IFS= read -r local_path; do
        [[ -z "$local_path" ]] && continue
        abs_local_path="$local_path"
        [[ "$local_path" != /* ]] && abs_local_path="$PWD/$local_path"
        
        if [[ "$added_abs_paths" != *$'\n'"$abs_local_path"$'\n'* ]]; then
            COMPREPLY+=("$local_path")
            added_abs_paths+="${abs_local_path}"$'\n'
        fi
    done < <( if [[ "$target" == "$dirfile" ]]; then compgen -d -- "$2"; else compgen -f -- "$2"; fi )
}

_lazy_read() {
    [[ -z "$2" ]] && return 1
    [[ -f "$1" ]] || return 1

    local raw_query="${*:2}"
    local query_pattern="${raw_query// /*}"
    local query_lower_pattern="${query_pattern,,}" path rest
    
    while IFS="|" read -r path rest; do
        [[ -z "$path" ]] && continue
        local basename="${path##*/}"
        if [[ "${basename,,}" == *${query_lower_pattern}* ]] && [[ "$query_pattern" == "$query_lower_pattern" || "$basename" == *${query_pattern}* ]]; then
            echo "$path"
            return 0
        fi
    done < "$1"

    return 1
}

complete -o nosort -o filenames -o dirnames -o bashdefault -o default -F _lazy_complete_func cd
complete -o nosort -o filenames -o bashdefault -o default -F _lazy_complete_func "$_LAZY_EDITOR_NAME"

cd() {
    local old_pwd="$(command pwd -P 2>/dev/null)"
    if [[ $# -eq 0 ]]; then
        builtin cd || return
    elif [[ "$1" == "-" || -d "$*" ]]; then
        builtin cd "$*" || return
    else
        builtin cd "$(_lazy_read "$dirfile" "$@" || echo "$*")" || return
    fi
    local new_pwd="$(command pwd -P 2>/dev/null)"

    if [[ "$-" == *i* ]] && [[ "$old_pwd" != "$new_pwd" ]] && ! _lazy_is_blacklisted "$_LAZY_DIR_BLACKLIST" "$new_pwd"; then
        (_lazy_write "$dirfile" "$new_pwd" 2>/dev/null &)
    fi
}

eval "
${_LAZY_EDITOR_NAME}() {
    [[ \$# -eq 0 || \" \$*\" == *\" \"[-+]* ]] && { command \${EDITOR} \"\$@\"; return; }

    local target
    local -a exec_cmd
    for target in \"\$@\"; do
        exec_cmd=(\$EDITOR)
               
        if [[ \"\$target\" != */* && ! -e \"\$target\" ]]; then
            local match=\"\$(_lazy_read \"\$filefile\" \"\$target\" 2>/dev/null)\"
            [[ -n \"\$match\" ]] && target=\"\$match\"
        fi
               
        if [[ -f \"\$target\" ]]; then
            [[ \"\$target\" != /* ]] && target=\"\$(realpath -m \"\$target\" 2>/dev/null || echo \"\$target\")\"
            _lazy_is_blacklisted \"\$_LAZY_FILE_BLACKLIST\" \"\$target\" || (_lazy_write \"\$filefile\" \"\$target\" &)
            [[ ! -w \"\$target\" ]] && exec_cmd=(sudo -e)
        else
            local dname=\"\$(dirname \"\$target\" 2>/dev/null)\"
            [[ -d \"\$dname\" && ! -w \"\$dname\" ]] && exec_cmd=(sudo \$EDITOR)
        fi

        command \"\${exec_cmd[@]}\" \"\$target\"
    done
}"
