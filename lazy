# Stripped down for minimal "drop-in" smart cd/editor usage.

[ -d "${_LAZY_DIR_DATA:-$HOME/.lazydir}" ] && {
    echo "ERROR: lazy's directory datafile (${_LAZY_DIR_DATA:-$HOME/.lazydir}) is a directory."
}
[ -d "${_LAZY_FILE_DATA:-$HOME/.lazyfile}" ] && {
    echo "ERROR: lazy's file datafile (${_LAZY_FILE_DATA:-$HOME/.lazyfile}) is a directory."
}

_LAZY_EDITOR_NAME="${_LAZY_EDITOR:-${EDITOR:-vi}}"
_LAZY_EDITOR_NAME="${_LAZY_EDITOR_NAME%% *}"

_lazy() {
    # 1. Help menu
    case "$1" in
        help|-h|--help)
            local cmd="${_LAZY_CMD:-lazy}"
            cat <<EOF
$cmd - frecency-based smart cd and editor launcher

USAGE
  $cmd help            show this help
  cd foo               falls back to smart directory jump
  $_LAZY_EDITOR_NAME foo               falls back to smart file open

TUNABLES (export these in .bashrc/.zshrc before sourcing $cmd)
  _LAZY_CMD               command name to alias '_lazy' to (default: lazy)
  _LAZY_DIR_DATA          directory datafile path (default: ~/.lazydir)
  _LAZY_FILE_DATA         file datafile path (default: ~/.lazyfile)
  _LAZY_MAX_SCORE         aging threshold before scores decay (default: 9000)
  _LAZY_EDITOR            program used to open matched files (default: \$EDITOR, else vi)
  _LAZY_OWNER             username to chown datafiles to (for use under sudo)
  _LAZY_EXCLUDE_DIRS      array of path prefixes to never track
  _LAZY_NO_RESOLVE_SYMLINKS   don't resolve symlinks when tracking \$PWD
  _LAZY_NO_PROMPT_COMMAND     don't auto-hook PROMPT_COMMAND/precmd to track \$PWD
  _LAZY_NO_CD_WRAP        don't define the built-in cd() wrapper
  _LAZY_NO_E_WRAP         don't define the built-in e() wrapper
EOF
            return
            ;;
    esac

    local dirfile="${_LAZY_DIR_DATA:-$HOME/.lazydir}"
    local filefile="${_LAZY_FILE_DATA:-$HOME/.lazyfile}"

    [ -h "$dirfile" ] && dirfile=$(readlink "$dirfile")
    [ -h "$filefile" ] && filefile=$(readlink "$filefile")

    [ -z "$_LAZY_OWNER" -a -f "$dirfile" -a ! -O "$dirfile" ] && return
    [ -z "$_LAZY_OWNER" -a -f "$filefile" -a ! -O "$filefile" ] && return

    local mode=""

    _lazy_read () {
        local f="$1" type="$2" line p
        [ -f "$f" ] || return 0
        while read line; do
            p="${line%%\|*}"
            if [ "$type" = "d" ]; then
                [ -d "$p" ] && echo "$line"
            else
                [ -f "$p" ] && echo "$line"
            fi
        done < "$f"
        return 0
    }

    _lazy_entries () {
        case "$mode" in
            file) _lazy_read "$filefile" f;;
            dir)  _lazy_read "$dirfile" d;;
        esac
    }

    # 2. Add entry
    if [ "$1" = "--add" ]; then
        shift
        [ "$*" = "$HOME" -o "$*" = '/' ] && return

        if [ ${#_LAZY_EXCLUDE_DIRS[@]} -gt 0 ]; then
            local exclude
            for exclude in "${_LAZY_EXCLUDE_DIRS[@]}"; do
                case "$*" in "$exclude"*) return;; esac
            done
        fi

        local target type
        if [ -d "$*" ]; then
            target="$dirfile"; type=d
        elif [ -f "$*" ]; then
            target="$filefile"; type=f
        else
            return
        fi

        local tempfile="$target.$RANDOM"
        local score=${_LAZY_MAX_SCORE:-9000}
        _lazy_read "$target" "$type" | \awk -v path="$*" -v now="$(\date +%s)" -v score=$score -F"|" '
            BEGIN {
                rank[path] = 1
                time[path] = now
            }
            $2 >= 1 {
                if( $1 == path ) {
                    rank[$1] = $2 + 1
                    time[$1] = now
                } else {
                    rank[$1] = $2
                    time[$1] = $3
                }
                count += $2
            }
            END {
                if( count > score ) {
                    for( x in rank ) print x "|" 0.99*rank[x] "|" time[x]
                } else for( x in rank ) print x "|" rank[x] "|" time[x]
            }
        ' 2>/dev/null >| "$tempfile"

        if [ $? -ne 0 -a -f "$target" ]; then
            \env rm -f "$tempfile"
        else
            [ "$_LAZY_OWNER" ] && chown $_LAZY_OWNER:"$(id -ng $_LAZY_OWNER)" "$tempfile"
            \env mv -f "$tempfile" "$target" || \env rm -f "$tempfile"
        fi

    # 3. Tab completion
    elif [ "$1" = "--complete" -a \( -s "$dirfile" -o -s "$filefile" \) ]; then
        local complline="$2" firstword
        firstword="${complline%% *}"
        case "$firstword" in
            cd) mode="dir";;
            "$_LAZY_EDITOR_NAME") mode="file";;
            *) return;; # Only supply completion for cd/editor wrappers
        esac
        
        local query="${complline#"$firstword" }"
        case "$query" in */*) return;; esac # Let bash handle actual paths

        _lazy_entries | \awk -v q="$query" -F"|" '
            BEGIN {
                if( q == tolower(q) ) imatch = 1
                gsub(/ /, ".*", q)
            }
            {
                if( imatch ) {
                    if( tolower($1) ~ q ) print $1
                } else if( $1 ~ q ) print $1
            }
        ' 2>/dev/null

    # 4. Search and Go
    else
        case "$1" in
            file) mode="file"; shift;;
            dir)  mode="dir"; shift;;
            *) return 1;; 
        esac

        local fnd="$*"
        [ -n "$fnd" ] || return 1

        case "$mode" in
            file) [ -f "$filefile" ] || return 1;;
            dir)  [ -f "$dirfile" ] || return 1;;
        esac

        local target_path
        target_path="$( < <( _lazy_entries ) \awk -v t="$(\date +%s)" -v q="$fnd" -F"|" '
            function frecent(rank, time) {
              dx = t - time
              return int(10000 * rank * (3.75/((0.0001 * dx + 1) + 0.25)))
            }
            BEGIN {
                gsub(" ", ".*", q)
                hi_rank = ihi_rank = -9999999999
            }
            {
                rank = frecent($2, $3)
                if( $1 ~ q ) {
                    if( rank > hi_rank ) { best_match = $1; hi_rank = rank }
                } else if( tolower($1) ~ tolower(q) ) {
                    if( rank > ihi_rank ) { ibest_match = $1; ihi_rank = rank }
                }
            }
            END {
                if( best_match ) { print best_match; exit }
                if( ibest_match ) { print ibest_match; exit }
                exit(1)
            }
        ')"
        
        local awk_ret=$?

        if [ "$awk_ret" -eq 0 ] && [ -n "$target_path" ]; then
            if [ "$mode" = "dir" ] && [ -d "$target_path" ]; then
                builtin cd "$target_path"
                return 0
            elif [ "$mode" = "file" ] && [ -f "$target_path" ]; then
                (_lazy --add "$target_path" &)
                ${_LAZY_EDITOR:-${EDITOR:-vi}} "$target_path"
                return 0
            fi
        fi
        
        # CRITICAL FIX: Explicitly return 1 if no match was found/opened
        return 1
    fi
}

alias ${_LAZY_CMD:-lazy}='_lazy 2>&1'

[ "$_LAZY_NO_RESOLVE_SYMLINKS" ] || _LAZY_RESOLVE_SYMLINKS="-P"

if type compctl >/dev/null 2>&1; then
    # zsh
    [ "$_LAZY_NO_PROMPT_COMMAND" ] || {
        if [ "$_LAZY_NO_RESOLVE_SYMLINKS" ]; then
            _lazy_precmd() { (_lazy --add "${PWD:a}" &); : $RANDOM; }
        else
            _lazy_precmd() { (_lazy --add "${PWD:A}" &); : $RANDOM; }
        fi
        [[ -n "${precmd_functions[(r)_lazy_precmd]}" ]] || {
            precmd_functions[$(($#precmd_functions+1))]=_lazy_precmd
        }
    }
    _lazy_zsh_tab_completion() {
        local compl
        read -l compl
        reply=(${(f)"$(_lazy --complete "$compl")"})
    }
    [ "$_LAZY_NO_CD_WRAP" ] || compctl -U -K _lazy_zsh_tab_completion cd
    [ "$_LAZY_NO_E_WRAP" ] || compctl -U -K _lazy_zsh_tab_completion "$_LAZY_EDITOR_NAME"
elif type complete >/dev/null 2>&1; then
    # bash
    [ "$_LAZY_NO_CD_WRAP" ] || complete -o filenames -o dirnames -o bashdefault -o default -C '_lazy --complete "$COMP_LINE"' cd
    [ "$_LAZY_NO_E_WRAP" ] || complete -o filenames -o bashdefault -o default -C '_lazy --complete "$COMP_LINE"' "$_LAZY_EDITOR_NAME"
    [ "$_LAZY_NO_PROMPT_COMMAND" ] || {
        grep "_lazy --add" <<< "$PROMPT_COMMAND" >/dev/null || {
            PROMPT_COMMAND="$PROMPT_COMMAND"$'\n''(_lazy --add "$(command pwd '$_LAZY_RESOLVE_SYMLINKS' 2>/dev/null)" 2>/dev/null &);'
        }
    }
fi

[ "$_LAZY_NO_CD_WRAP" ] || {
    cd() {
        if [ $# -eq 0 ]; then
            builtin cd "$HOME" || return
        elif [ -d "$1" ] || [ "$1" = "-" ]; then
            builtin cd "$@" || return
        else
            _lazy dir "$@" || builtin cd "$@"
        fi
    }
}

[ "$_LAZY_NO_E_WRAP" ] || eval "
${_LAZY_EDITOR_NAME}() {
    if [ -f \"\$1\" ]; then
        (_lazy --add \"\$1\" &)
        command \${_LAZY_EDITOR:-\${EDITOR:-vi}} \"\$@\"
    elif [[ \"\$1\" == */* ]]; then
        command \${_LAZY_EDITOR:-\${EDITOR:-vi}} \"\$@\"
    else
        _lazy file \"\$@\" || command \${_LAZY_EDITOR:-\${EDITOR:-vi}} \"\$@\"
    fi
}
"
